{
  "class": {
    "prefix": "class",
    "body": [
      "class ${1:ClassName}",
      "{",
      "\t${0}",
      "}"
    ],
    "description": "Class declaration"
  },
  "public_class": {
    "prefix": "pclass",
    "body": [
      "public class ${1:ClassName}",
      "{",
      "\t${0}",
      "}"
    ],
    "description": "Public class declaration"
  },
  "class_with_inherit": {
    "prefix": "xclass",
    "body": [
      "public class ${1:ClassName} extends ${2:ParentClass}",
      "{",
      "\t${0}",
      "}"
    ],
    "description": "Class with inheritance"
  },
  "interface": {
    "prefix": "iface",
    "body": [
      "interface ${1:InterfaceName}",
      "{",
      "\t${0}",
      "}"
    ],
    "description": "Interface declaration"
  },
  "enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:EnumName}",
      "{",
      "\t${0}",
      "}"
    ],
    "description": "Enum declaration"
  },
  "method": {
    "prefix": "method",
    "body": [
      "public ${1:void} ${2:methodName}(${3})",
      "{",
      "\t${0}",
      "}"
    ],
    "description": "Method declaration"
  },
  "static_method": {
    "prefix": "smethod",
    "body": [
      "public static ${1:void} ${2:methodName}(${3})",
      "{",
      "\t${0}",
      "}"
    ],
    "description": "Static method declaration"
  },
  "field": {
    "prefix": "field",
    "body": "public ${1:int} ${2:fieldName};",
    "description": "Public field"
  },
  "constructor": {
    "prefix": "ctor",
    "body": [
      "public ${1:ClassName}(${2})",
      "{",
      "\tsuper(${3});",
      "\t${0}",
      "}"
    ],
    "description": "Constructor"
  },
  "main": {
    "prefix": "main",
    "body": [
      "public static void main(String[] args)",
      "{",
      "\t${0}",
      "}"
    ],
    "description": "Main method"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if (${1:condition})",
      "{",
      "\t${0}",
      "}"
    ],
    "description": "If statement"
  },
  "ifelse": {
    "prefix": "ifelse",
    "body": [
      "if (${1:condition})",
      "{",
      "\t${2}",
      "}",
      "else",
      "{",
      "\t${0}",
      "}"
    ],
    "description": "If-else statement"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for (int ${1:i} = 0; $1 < ${2:n}; $1++)",
      "{",
      "\t${0}",
      "}"
    ],
    "description": "For loop"
  },
  "foreach": {
    "prefix": "foreach",
    "body": [
      "for (int ${1:i} = 0; $1 < ${2:array}.size(); $1++)",
      "{",
      "\t${0}",
      "}"
    ],
    "description": "For loop over array"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while (${1:condition})",
      "{",
      "\t${0}",
      "}"
    ],
    "description": "While loop"
  },
  "match": {
    "prefix": "match",
    "body": [
      "match (${1:expr})",
      "{",
      "\t${2:Pattern} => ${0}",
      "}"
    ],
    "description": "Match expression"
  },
  "return": {
    "prefix": "ret",
    "body": "return ${0};",
    "description": "Return statement"
  },
  "printf": {
    "prefix": "printf",
    "body": "System.printf(\"${1:format}\"${2:, args});",
    "description": "Print formatted"
  },
  "package": {
    "prefix": "pkg",
    "body": "package ${1:name};",
    "description": "Package declaration"
  },
  "var": {
    "prefix": "var",
    "body": "${1:int} ${2:name} = ${0};",
    "description": "Variable declaration"
  },
  "trycatch": {
    "prefix": "try",
    "body": [
      "try",
      "{",
      "\t${1}",
      "}",
      "catch (${2:Exception} e)",
      "{",
      "\t${0}",
      "}"
    ],
    "description": "Try-catch block"
  },
  "new_array": {
    "prefix": "arr",
    "body": "Array<${1:int}> ${2:name} = new Array<${1:int}>();",
    "description": "New Array"
  },
  "new_map": {
    "prefix": "map",
    "body": "Map<${1:String}, ${2:String}> ${3:name} = new Map<${1:String}, ${2:String}>();",
    "description": "New Map"
  }
}
