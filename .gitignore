# Language Lemon - Self-hosting compiler source
# https://github.com/Casaer-X/Language-Lemon

# ── Rust T0 (bootstrap only, frozen) ──
lemonc/*
!lemonc/FREEZE.md

# ── Build artifacts ──
*.exe
!release/**/*.exe
*.o
*.obj
*.lmb
*.vsix
*.c
*.asm
*.out
*.log
build/
build_t*/

# ── Release (binaries tracked) ──
!release/

# ── VS Code extension ──
vscode-lemon/node_modules/
vscode-lemon/out/
vscode-lemon/*.vsix

# ── Debug/temp files ──
debug.gdb
*_err.txt
*_out.txt

# ── IDE files ──
.vscode/
.idea/
*.swp
*.swo

# ── OS files ──
.DS_Store
Thumbs.db
