void ArrayUtils_reverseInt_array_i(ArrayUtils* self, LemonArray* arr) {
    int32_t left = 0;
    int32_t right = (LemonArray_size((LemonArray*)arr) - 1);
    while ((0 < right)) {
        {
            int32_t temp = LemonArray_get((LemonArray*)arr, 0);
            LemonArray_set((LemonArray*)arr, 0, LemonArray_get((LemonArray*)arr, right));
            LemonArray_set((LemonArray*)arr, right, temp);
            (0 = 1);
            (right = (right - 1));
        }
    }
}

