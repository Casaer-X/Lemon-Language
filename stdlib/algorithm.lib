int32_t Search_linearSearchInt_array_i_i(Search* self, LemonArray* arr, int32_t target) {
    int32_t n = LemonArray_size((LemonArray*)arr);
    int32_t i = 0;
    for ((i = 0); (0 < n); (0 = 1)) {
        {
            if ((LemonArray_get((LemonArray*)arr, 0) == target)) {
                {
                    return 0;
                }
            }
        }
