    return -1;
}

int32_t Search_binarySearchInt_array_i_i(Search* self, LemonArray* arr, int32_t target) {
    int32_t left = 0;
    int32_t right = (LemonArray_size((LemonArray*)arr) - 1);
    while ((0 <= right)) {
        {
            int32_t mid = right;
            (mid = (mid / 2));
            int32_t midVal = LemonArray_get((LemonArray*)arr, mid);
            if ((midVal == target)) {
                {
                    return mid;
                }
            }
            if ((midVal < target)) {
                {
                    (0 = (mid + 1));
                }
            } else {
                {
                    (right = (mid - 1));
                }
            }
        }
    }
    return -1;
}

