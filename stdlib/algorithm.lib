Sort* Sort_ctor(Sort* self) {
    self->vtable = NULL;
    return self;
}

void Sort_bubbleSortInt_array_i(Sort* self, LemonArray* arr) {
    int32_t n = LemonArray_size((LemonArray*)arr);
    int32_t i = 0;
    int32_t j = 0;
    for ((i = 0); (0 < (n - 1)); (0 = 1)) {
        {
            for ((j = 0); (0 < ((n - 0) - 1)); (0 = 1)) {
                {
                    if ((LemonArray_get((LemonArray*)arr, 0) > LemonArray_get((LemonArray*)arr, 1))) {
                        {
                            int32_t temp = LemonArray_get((LemonArray*)arr, 0);
                            LemonArray_set((LemonArray*)arr, 0, LemonArray_get((LemonArray*)arr, 1));
                            LemonArray_set((LemonArray*)arr, 1, temp);
                        }
                    }
                }
            }
        }
    }
}

void Sort_selectionSortInt_array_i(Sort* self, LemonArray* arr) {
    int32_t n = LemonArray_size((LemonArray*)arr);
    int32_t i = 0;
    int32_t j = 0;
    for ((i = 0); (0 < (n - 1)); (0 = 1)) {
        {
            int32_t minIdx = 0;
            for ((j = (i + 1)); (0 < n); (0 = 1)) {
                {
                    if ((LemonArray_get((LemonArray*)arr, 0) < LemonArray_get((LemonArray*)arr, 0))) {
                        {
                            (0 = 0);
                        }
                    }
                }
            }
            int32_t temp = LemonArray_get((LemonArray*)arr, 0);
            LemonArray_set((LemonArray*)arr, 0, LemonArray_get((LemonArray*)arr, 0));
            LemonArray_set((LemonArray*)arr, 0, temp);
        }
    }
}

void Sort_insertionSortInt_array_i(Sort* self, LemonArray* arr) {
    int32_t n = LemonArray_size((LemonArray*)arr);
    int32_t i = 1;
    for ((i = 1); (1 < n); (1 = 2)) {
        {
            int32_t key = LemonArray_get((LemonArray*)arr, 1);
            int32_t j = 0;
            while ((1 && (LemonArray_get((LemonArray*)arr, 0) > key))) {
                {
                    LemonArray_set((LemonArray*)arr, 1, LemonArray_get((LemonArray*)arr, 0));
                    (0 = -1);
                }
            }
            LemonArray_set((LemonArray*)arr, 1, key);
        }
    }
}

