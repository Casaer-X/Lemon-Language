package lemon.ir;

import lemon.parser.AST;
import lemon.ir.IRType;
import lemon.ir.IR;

// ============================================================
// IR 生成器
// 将 AST 转换为 SSA 形式的 IR
//
// 策略: 简化的 SSA 生成
// - 局部变量用 alloca + load/store 模式
// - 表达式生成 SSA 值
// - 控制流生成基本块和跳转
// ============================================================

class IRGen {
    private IRModule module;
    private IRFunction currentFunc;
    private int labelCounter;
    private Array<IRValue> localSlots;   // 局部变量 alloca 槽

    public IRGen() {
        this.module = null;
        this.currentFunc = null;
        this.labelCounter = 0;
        this.localSlots = new Array<IRValue>();
    }

    // ---- 生成入口 ----

    public IRModule generate(Program program) {
        this.module = new IRModule("lemon_module");
        this.labelCounter = 0;

        // 生成所有顶层函数
        for (int i = 0; i < program.declarations.size(); i++) {
            Declaration decl = program.declarations.get(i);
            if (decl.kind == DeclKind.Function && decl.functionDecl != null) {
                this.genFunction(decl.functionDecl);
            }
        }

        // 生成所有类方法
        for (int i = 0; i < program.declarations.size(); i++) {
            Declaration decl = program.declarations.get(i);
            if (decl.kind == DeclKind.Class && decl.classDecl != null) {
                this.genClass(decl.classDecl);
            }
        }

        return this.module;
    }

    // ---- 函数生成 ----

    private void genFunction(FunctionDecl funcDecl) {
        IRType retType = this.mapType(funcDecl.returnType);
        String funcName = funcDecl.name;
        IRFunction func = this.module.addFunction(funcName, retType);

        this.currentFunc = func;
        this.localSlots = new Array<IRValue>();

        // 入口块
        IRBasicBlock entry = func.addBlock("entry");

        // 参数处理
        for (int i = 0; i < funcDecl.params.size(); i++) {
            Param param = funcDecl.params.get(i);
            IRType paramType = this.mapType(param.paramType);
            func.addParam(param.name, paramType);
        }

        // 生成函数体
        if (funcDecl.body != null) {
            this.genBlock(funcDecl.body);
        }

        // 如果最后一个块没有终止指令，添加 ret void
        IRBasicBlock lastBlock = func.getCurrentBlock();
        if (lastBlock != null && !lastBlock.isTerminated()) {
            if (retType.isVoid()) {
                func.emitRetVoid();
            } else {
                IRValue zero = func.emitConstInt(retType, 0);
                func.emitRet(zero);
            }
        }

        this.currentFunc = null;
    }

    // ---- 类生成 ----

    private void genClass(ClassDecl classDecl) {
        for (int i = 0; i < classDecl.members.size(); i++) {
            ClassMember member = classDecl.members.get(i);
            if (member.kind == ClassMemberKind.Method && member.method != null) {
                String mangledName = classDecl.name + "_" + member.method.name;
                this.genMethod(mangledName, member.method);
            } else if (member.kind == ClassMemberKind.Constructor && member.constructor != null) {
                String mangledName = classDecl.name + "_init";
                this.genConstructor(mangledName, member.constructor);
            }
        }
    }

    private void genMethod(String name, MethodDecl methodDecl) {
        IRType retType = this.mapType(methodDecl.returnType);
        IRFunction func = this.module.addFunction(name, retType);

        this.currentFunc = func;
        this.localSlots = new Array<IRValue>();

        func.addBlock("entry");

        // this 参数
        func.addParam("this", IRType.ptr(IRType.i8()));

        for (int i = 0; i < methodDecl.params.size(); i++) {
            Param param = methodDecl.params.get(i);
            func.addParam(param.name, this.mapType(param.paramType));
        }

        if (methodDecl.body != null) {
            this.genBlock(methodDecl.body);
        }

        IRBasicBlock lastBlock = func.getCurrentBlock();
        if (lastBlock != null && !lastBlock.isTerminated()) {
            if (retType.isVoid()) {
                func.emitRetVoid();
            } else {
                func.emitRet(func.emitConstInt(retType, 0));
            }
        }

        this.currentFunc = null;
    }

    private void genConstructor(String name, ConstructorDecl ctorDecl) {
        IRFunction func = this.module.addFunction(name, IRType.ptr(IRType.i8()));

        this.currentFunc = func;
        this.localSlots = new Array<IRValue>();

        func.addBlock("entry");
        func.addParam("this", IRType.ptr(IRType.i8()));

        for (int i = 0; i < ctorDecl.params.size(); i++) {
            Param param = ctorDecl.params.get(i);
            func.addParam(param.name, this.mapType(param.paramType));
        }

        if (ctorDecl.body != null) {
            this.genBlock(ctorDecl.body);
        }

        IRBasicBlock lastBlock = func.getCurrentBlock();
        if (lastBlock != null && !lastBlock.isTerminated()) {
            func.emitRet(func.emitConstNull(IRType.ptr(IRType.i8())));
        }

        this.currentFunc = null;
    }

    // ---- 语句块生成 ----

    private void genBlock(Block block) {
        if (block == null) return;
        for (int i = 0; i < block.statements.size(); i++) {
            this.genStmt(block.statements.get(i));
        }
    }

    private void genStmt(Stmt stmt) {
        if (stmt == null) return;
        int kind = stmt.kind;

        if (kind == StmtKind.Expr) {
            this.genExpr(stmt.expr);
        } else if (kind == StmtKind.Return) {
            if (stmt.returnValue != null) {
                IRValue val = this.genExpr(stmt.returnValue);
                this.currentFunc.emitRet(val);
            } else {
                this.currentFunc.emitRetVoid();
            }
        } else if (kind == StmtKind.VarDecl) {
            if (stmt.varDecl != null) {
                IRType varType = this.mapType(stmt.varDecl.varType);
                IRValue slot = this.currentFunc.emitAlloca(varType, varType.sizeInBytes());
                this.localSlots.add(slot);
                if (stmt.varDecl.initializer != null) {
                    IRValue initVal = this.genExpr(stmt.varDecl.initializer);
                    this.currentFunc.emitStore(initVal, slot);
                }
            }
        } else if (kind == StmtKind.If) {
            String thenLabel = this.newLabel("if.then");
            String elseLabel = this.newLabel("if.else");
            String endLabel = this.newLabel("if.end");

            IRValue cond = this.genExpr(stmt.condition);
            if (stmt.elseBranch != null) {
                this.currentFunc.emitCondBr(cond, thenLabel, elseLabel);
            } else {
                this.currentFunc.emitCondBr(cond, thenLabel, endLabel);
            }

            // then 块
            this.currentFunc.addBlock(thenLabel);
            this.genStmt(stmt.thenBranch);
            IRBasicBlock thenBlock = this.currentFunc.getCurrentBlock();
            if (!thenBlock.isTerminated()) {
                this.currentFunc.emitBr(endLabel);
            }

            // else 块
            if (stmt.elseBranch != null) {
                this.currentFunc.addBlock(elseLabel);
                this.genStmt(stmt.elseBranch);
                IRBasicBlock elseBlock = this.currentFunc.getCurrentBlock();
                if (!elseBlock.isTerminated()) {
                    this.currentFunc.emitBr(endLabel);
                }
            }

            // end 块
            this.currentFunc.addBlock(endLabel);
        } else if (kind == StmtKind.While) {
            String condLabel = this.newLabel("while.cond");
            String bodyLabel = this.newLabel("while.body");
            String endLabel = this.newLabel("while.end");

            this.currentFunc.emitBr(condLabel);

            this.currentFunc.addBlock(condLabel);
            IRValue cond = this.genExpr(stmt.condition);
            this.currentFunc.emitCondBr(cond, bodyLabel, endLabel);

            this.currentFunc.addBlock(bodyLabel);
            this.genStmt(stmt.body);
            IRBasicBlock bodyBlock = this.currentFunc.getCurrentBlock();
            if (!bodyBlock.isTerminated()) {
                this.currentFunc.emitBr(condLabel);
            }

            this.currentFunc.addBlock(endLabel);
        } else if (kind == StmtKind.For) {
            String condLabel = this.newLabel("for.cond");
            String bodyLabel = this.newLabel("for.body");
            String updateLabel = this.newLabel("for.update");
            String endLabel = this.newLabel("for.end");

            // init
            if (stmt.init != null) this.genStmt(stmt.init);
            this.currentFunc.emitBr(condLabel);

            // condition
            this.currentFunc.addBlock(condLabel);
            if (stmt.forCond != null) {
                IRValue cond = this.genExpr(stmt.forCond);
                this.currentFunc.emitCondBr(cond, bodyLabel, endLabel);
            } else {
                this.currentFunc.emitBr(bodyLabel);
            }

            // body
            this.currentFunc.addBlock(bodyLabel);
            this.genStmt(stmt.body);
            IRBasicBlock bodyBlock = this.currentFunc.getCurrentBlock();
            if (!bodyBlock.isTerminated()) {
                this.currentFunc.emitBr(updateLabel);
            }

            // update
            this.currentFunc.addBlock(updateLabel);
            if (stmt.update != null) this.genExpr(stmt.update);
            this.currentFunc.emitBr(condLabel);

            this.currentFunc.addBlock(endLabel);
        } else if (kind == StmtKind.Block) {
            this.genStmts(stmt.statements);
        } else if (kind == StmtKind.Break || kind == StmtKind.Continue) {
            // 简化: 暂不实现 break/continue 的跳转目标
        }
    }

    private void genStmts(Array<Stmt> stmts) {
        if (stmts == null) return;
        for (int i = 0; i < stmts.size(); i++) {
            this.genStmt(stmts.get(i));
        }
    }

    // ---- 表达式生成 ----

    private IRValue genExpr(Expr expr) {
        if (expr == null) return this.currentFunc.emitConstNull(IRType.ptr(IRType.i8()));

        int kind = expr.kind;

        if (kind == ExprKind.IntegerLiteral) {
            return this.currentFunc.emitConstInt(IRType.i64(), expr.longValue);
        } else if (kind == ExprKind.FloatLiteral) {
            return this.currentFunc.emitConstFloat(IRType.f64(), expr.doubleValue);
        } else if (kind == ExprKind.StringLiteral) {
            this.module.addString(expr.strValue);
            return this.currentFunc.emitConstStr(expr.strValue);
        } else if (kind == ExprKind.BoolLiteral) {
            return this.currentFunc.emitConstBool(expr.boolValue);
        } else if (kind == ExprKind.Null) {
            return this.currentFunc.emitConstNull(IRType.ptr(IRType.i8()));
        } else if (kind == ExprKind.This) {
            // this 是第一个参数
            if (this.currentFunc.params.size() > 0) {
                IRParam thisParam = this.currentFunc.params.get(0);
                return new IRValue(0, thisParam.name, thisParam.type);
            }
            return this.currentFunc.emitConstNull(IRType.ptr(IRType.i8()));
        } else if (kind == ExprKind.Variable) {
            // 查找变量: 先在参数中找，再在局部变量中找
            String varName = expr.strValue;
            for (int i = 0; i < this.currentFunc.params.size(); i++) {
                IRParam param = this.currentFunc.params.get(i);
                String paramName = param.name;
                if (paramName.equals(varName)) {
                    return new IRValue(i, varName, param.type);
                }
            }
            // 局部变量: load from slot
            int slotIdx = this.findLocalSlot(varName);
            if (slotIdx >= 0) {
                IRValue slot = this.localSlots.get(slotIdx);
                return this.currentFunc.emitLoad(slot.type.elementType, slot);
            }
            return this.currentFunc.emitConstNull(IRType.ptr(IRType.i8()));
        } else if (kind == ExprKind.BinaryOp) {
            IRValue lhs = this.genExpr(expr.left);
            IRValue rhs = this.genExpr(expr.right);
            int op = expr.opValue;
            return this.genBinaryOp(op, lhs, rhs);
        } else if (kind == ExprKind.UnaryOp) {
            IRValue operand = this.genExpr(expr.operand);
            int op = expr.opValue;
            if (op == UnaryOp.Minus) {
                return this.currentFunc.emitNeg(operand.type, operand);
            } else if (op == UnaryOp.Not) {
                return this.currentFunc.emitNot(operand.type, operand);
            } else if (op == UnaryOp.BitNot) {
                return this.currentFunc.emitNot(operand.type, operand);
            }
            return operand;
        } else if (kind == ExprKind.Call) {
            Array<IRValue> callArgs = new Array<IRValue>();
            if (expr.args != null) {
                for (int i = 0; i < expr.args.size(); i++) {
                    callArgs.add(this.genExpr(expr.args.get(i)));
                }
            }
            String calleeName = this.getCalleeName(expr.callee);
            return this.currentFunc.emitCall(IRType.i64(), calleeName, callArgs);
        } else if (kind == ExprKind.MethodCall) {
            Array<IRValue> callArgs = new Array<IRValue>();
            if (expr.receiver != null) {
                callArgs.add(this.genExpr(expr.receiver));
            }
            if (expr.args != null) {
                for (int i = 0; i < expr.args.size(); i++) {
                    callArgs.add(this.genExpr(expr.args.get(i)));
                }
            }
            String calleeName = expr.strValue;
            return this.currentFunc.emitCall(IRType.i64(), calleeName, callArgs);
        } else if (kind == ExprKind.FieldAccess) {
            IRValue obj = this.genExpr(expr.receiver);
            return this.currentFunc.emitGEP(IRType.i64(), obj, 0);
        } else if (kind == ExprKind.Assignment) {
            IRValue val = this.genExpr(expr.value);
            // 简化: 直接返回值
            return val;
        } else if (kind == ExprKind.New) {
            Array<IRValue> callArgs = new Array<IRValue>();
            if (expr.args != null) {
                for (int i = 0; i < expr.args.size(); i++) {
                    callArgs.add(this.genExpr(expr.args.get(i)));
                }
            }
            String calleeName = expr.strValue + "_init";
            return this.currentFunc.emitCall(IRType.ptr(IRType.i8()), calleeName, callArgs);
        } else if (kind == ExprKind.ArrayAccess) {
            IRValue arr = this.genExpr(expr.receiver);
            IRValue idx = this.genExpr(expr.index);
            return this.currentFunc.emitGEP(IRType.i64(), arr, 0);
        }

        return this.currentFunc.emitConstNull(IRType.ptr(IRType.i8()));
    }

    // ---- 二元运算生成 ----

    private IRValue genBinaryOp(int op, IRValue lhs, IRValue rhs) {
        IRType type = lhs.type;

        if (op == BinaryOp.Add) return this.currentFunc.emitBinOp(IROpCode.ADD, type, lhs, rhs);
        if (op == BinaryOp.Sub) return this.currentFunc.emitBinOp(IROpCode.SUB, type, lhs, rhs);
        if (op == BinaryOp.Mul) return this.currentFunc.emitBinOp(IROpCode.MUL, type, lhs, rhs);
        if (op == BinaryOp.Div) return this.currentFunc.emitBinOp(IROpCode.DIV, type, lhs, rhs);
        if (op == BinaryOp.Mod) return this.currentFunc.emitBinOp(IROpCode.MOD, type, lhs, rhs);
        if (op == BinaryOp.BitAnd) return this.currentFunc.emitBinOp(IROpCode.AND, type, lhs, rhs);
        if (op == BinaryOp.BitOr) return this.currentFunc.emitBinOp(IROpCode.OR, type, lhs, rhs);
        if (op == BinaryOp.BitXor) return this.currentFunc.emitBinOp(IROpCode.XOR, type, lhs, rhs);
        if (op == BinaryOp.Shl) return this.currentFunc.emitBinOp(IROpCode.SHL, type, lhs, rhs);
        if (op == BinaryOp.Shr) return this.currentFunc.emitBinOp(IROpCode.SHR, type, lhs, rhs);
        if (op == BinaryOp.Eq) return this.currentFunc.emitCmp(IROpCode.EQ, lhs, rhs);
        if (op == BinaryOp.Ne) return this.currentFunc.emitCmp(IROpCode.NE, lhs, rhs);
        if (op == BinaryOp.Lt) return this.currentFunc.emitCmp(IROpCode.LT, lhs, rhs);
        if (op == BinaryOp.Gt) return this.currentFunc.emitCmp(IROpCode.GT, lhs, rhs);
        if (op == BinaryOp.Le) return this.currentFunc.emitCmp(IROpCode.LE, lhs, rhs);
        if (op == BinaryOp.Ge) return this.currentFunc.emitCmp(IROpCode.GE, lhs, rhs);
        if (op == BinaryOp.And) {
            // 逻辑 AND: select
            return this.currentFunc.emitSelect(lhs, rhs, this.currentFunc.emitConstBool(false));
        }
        if (op == BinaryOp.Or) {
            return this.currentFunc.emitSelect(lhs, this.currentFunc.emitConstBool(true), rhs);
        }

        return lhs;
    }

    // ---- 辅助方法 ----

    private String newLabel(String prefix) {
        this.labelCounter = this.labelCounter + 1;
        return prefix + "." + this.labelCounter;
    }

    private int findLocalSlot(String name) {
        // 简化: 按索引查找
        // 实际实现需要维护名称到槽的映射
        return -1;
    }

    private String getCalleeName(Expr callee) {
        if (callee == null) return "unknown";
        if (callee.kind == ExprKind.Variable) return callee.strValue;
        if (callee.kind == ExprKind.MethodCall) return callee.strValue;
        return "unknown";
    }

    private IRType mapType(TypeRef typeRef) {
        if (typeRef == null) return IRType.i64();
        String name = typeRef.name;
        if (name.equals("void")) return IRType.voidType();
        if (name.equals("bool")) return IRType.boolType();
        if (name.equals("int") || name.equals("int32")) return IRType.i32();
        if (name.equals("long") || name.equals("int64")) return IRType.i64();
        if (name.equals("float")) return IRType.f32();
        if (name.equals("double")) return IRType.f64();
        if (name.equals("byte") || name.equals("int8")) return IRType.i8();
        if (name.equals("short") || name.equals("int16")) return IRType.i16();
        if (name.equals("String")) return IRType.ptr(IRType.i8());
        return IRType.ptr(IRType.i8()); // 默认: 指针
    }
}
