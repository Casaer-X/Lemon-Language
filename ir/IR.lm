package lemon.ir;

import lemon.ir.IRType;

// ============================================================
// IR 指令定义 (SSA 形式)
// 每条指令产生至多一个结果值，操作数是值引用
// ============================================================

// IR 指令操作码
class IROpCode {
    // ---- 算术 ----
    public static int ADD = 1;
    public static int SUB = 2;
    public static int MUL = 3;
    public static int DIV = 4;
    public static int MOD = 5;
    public static int NEG = 6;

    // ---- 位运算 ----
    public static int AND = 10;
    public static int OR = 11;
    public static int XOR = 12;
    public static int SHL = 13;
    public static int SHR = 14;
    public static int NOT = 15;

    // ---- 比较 ----
    public static int EQ = 20;
    public static int NE = 21;
    public static int LT = 22;
    public static int GT = 23;
    public static int LE = 24;
    public static int GE = 25;

    // ---- 内存 ----
    public static int ALLOCA = 30;
    public static int LOAD = 31;
    public static int STORE = 32;
    public static int GEP = 33;       // GetElementPtr
    public static int MEMCPY = 34;

    // ---- 控制 ----
    public static int BR = 40;        // 无条件跳转
    public static int CONDBR = 41;    // 条件跳转
    public static int CALL = 42;
    public static int RET = 43;
    public static int SWITCH = 44;
    public static int PHI = 45;       // SSA phi 节点

    // ---- 转换 ----
    public static int BITCAST = 50;
    public static int INTTOPTR = 51;
    public static int PTRTOINT = 52;
    public static int ZEXT = 53;      // 零扩展
    public static int SEXT = 54;      // 符号扩展
    public static int TRUNC = 55;     // 截断
    public static int FPTOUI = 56;    // 浮点转无符号整数
    public static int FPTOSI = 57;    // 浮点转有符号整数
    public static int UITOFP = 58;    // 无符号整数转浮点
    public static int SITOFP = 59;    // 有符号整数转浮点
    public static int FPTRUNC = 60;   // 浮点截断
    public static int FPEXT = 61;     // 浮点扩展

    // ---- 常量 ----
    public static int CONST_INT = 70;
    public static int CONST_FLOAT = 71;
    public static int CONST_NULL = 72;
    public static int CONST_STR = 73;
    public static int CONST_BOOL = 74;

    // ---- 其他 ----
    public static int SELECT = 80;    // 三元选择
    public static int EXTRACTVALUE = 81;
    public static int INSERTVALUE = 82;
}

// IR 值引用 (SSA 值)
class IRValue {
    public int index;          // 在基本块中的指令索引
    public String name;        // 命名值 (%x, %1 等)
    public IRType type;

    public IRValue(int index, String name, IRType type) {
        this.index = index;
        this.name = name;
        this.type = type;
    }

    public String toString() {
        return this.name;
    }
}

// IR 基本块
class IRBasicBlock {
    public String label;
    public Array<IRInstruction> instructions;
    public Array<IRValue> values;       // 本块定义的值
    public Array<IRBasicBlock> predecessors;
    public Array<IRBasicBlock> successors;

    public IRBasicBlock(String label) {
        this.label = label;
        this.instructions = new Array<IRInstruction>();
        this.values = new Array<IRValue>();
        this.predecessors = new Array<IRBasicBlock>();
        this.successors = new Array<IRBasicBlock>();
    }

    public void addInstruction(IRInstruction inst) {
        this.instructions.add(inst);
    }

    public bool isTerminated() {
        if (this.instructions.size() == 0) return false;
        IRInstruction lastInst = this.instructions.get(this.instructions.size() - 1);
        int lastOp = lastInst.opcode;
        return lastOp == IROpCode.BR || lastOp == IROpCode.CONDBR
            || lastOp == IROpCode.RET || lastOp == IROpCode.SWITCH;
    }
}

// IR 指令
class IRInstruction {
    public int opcode;
    public IRType resultType;       // 结果类型 (null 表示无结果)
    public String resultName;       // 结果名 (%x, null 表示无结果)
    public IRValue operand1;        // 操作数1
    public IRValue operand2;        // 操作数2
    public IRValue operand3;        // 操作数3
    public long intImm;            // 整数立即数
    public double floatImm;        // 浮点立即数
    public String strValue;         // 字符串值
    public bool boolImm;           // 布尔值
    public String targetLabel;      // 跳转目标标签
    public String falseLabel;       // 条件跳转 false 目标
    public String calleeName;       // 调用目标名
    public Array<IRValue> args;     // 调用参数
    public Array<IRPhiEntry> phiEntries; // phi 条目
    public int allocaSize;          // alloca 大小
    public int gepIndex;            // GEP 索引

    public IRInstruction(int opcode) {
        this.opcode = opcode;
        this.resultType = null;
        this.resultName = null;
        this.operand1 = null;
        this.operand2 = null;
        this.operand3 = null;
        this.intImm = 0;
        this.floatImm = 0.0;
        this.strValue = "";
        this.boolImm = false;
        this.targetLabel = "";
        this.falseLabel = "";
        this.calleeName = "";
        this.args = null;
        this.phiEntries = null;
        this.allocaSize = 0;
        this.gepIndex = 0;
    }

    public bool hasResult() {
        return this.resultName != null && this.resultName.length() > 0;
    }

    public String toString() {
        StringBuilder sb = new StringBuilder();
        if (this.hasResult()) {
            sb.append(this.resultName + " = ");
        }
        sb.append(this.opcodeName());
        sb.append(this.operandsStr());
        return sb.toString();
    }

    public String opcodeName() {
        if (this.opcode == IROpCode.ADD) return "add";
        if (this.opcode == IROpCode.SUB) return "sub";
        if (this.opcode == IROpCode.MUL) return "mul";
        if (this.opcode == IROpCode.DIV) return "div";
        if (this.opcode == IROpCode.MOD) return "mod";
        if (this.opcode == IROpCode.NEG) return "neg";
        if (this.opcode == IROpCode.AND) return "and";
        if (this.opcode == IROpCode.OR) return "or";
        if (this.opcode == IROpCode.XOR) return "xor";
        if (this.opcode == IROpCode.SHL) return "shl";
        if (this.opcode == IROpCode.SHR) return "shr";
        if (this.opcode == IROpCode.NOT) return "not";
        if (this.opcode == IROpCode.EQ) return "eq";
        if (this.opcode == IROpCode.NE) return "ne";
        if (this.opcode == IROpCode.LT) return "lt";
        if (this.opcode == IROpCode.GT) return "gt";
        if (this.opcode == IROpCode.LE) return "le";
        if (this.opcode == IROpCode.GE) return "ge";
        if (this.opcode == IROpCode.ALLOCA) return "alloca";
        if (this.opcode == IROpCode.LOAD) return "load";
        if (this.opcode == IROpCode.STORE) return "store";
        if (this.opcode == IROpCode.GEP) return "gep";
        if (this.opcode == IROpCode.BR) return "br";
        if (this.opcode == IROpCode.CONDBR) return "condbr";
        if (this.opcode == IROpCode.CALL) return "call";
        if (this.opcode == IROpCode.RET) return "ret";
        if (this.opcode == IROpCode.PHI) return "phi";
        if (this.opcode == IROpCode.CONST_INT) return "const";
        if (this.opcode == IROpCode.CONST_FLOAT) return "const";
        if (this.opcode == IROpCode.CONST_NULL) return "null";
        if (this.opcode == IROpCode.CONST_STR) return "const.str";
        if (this.opcode == IROpCode.CONST_BOOL) return "const.bool";
        if (this.opcode == IROpCode.ZEXT) return "zext";
        if (this.opcode == IROpCode.SEXT) return "sext";
        if (this.opcode == IROpCode.TRUNC) return "trunc";
        if (this.opcode == IROpCode.BITCAST) return "bitcast";
        if (this.opcode == IROpCode.SELECT) return "select";
        return "op" + this.opcode;
    }

    private String operandsStr() {
        StringBuilder sb = new StringBuilder();
        if (this.opcode == IROpCode.CONST_INT) {
            sb.append(" " + this.intImm);
        } else if (this.opcode == IROpCode.CONST_FLOAT) {
            sb.append(" " + this.floatImm);
        } else if (this.opcode == IROpCode.CONST_NULL) {
            sb.append(" null");
        } else if (this.opcode == IROpCode.CONST_STR) {
            sb.append(" \"" + this.strValue + "\"");
        } else if (this.opcode == IROpCode.CONST_BOOL) {
            sb.append(" " + (this.boolImm ? "true" : "false"));
        } else if (this.opcode == IROpCode.BR) {
            sb.append(" label " + this.targetLabel);
        } else if (this.opcode == IROpCode.CONDBR) {
            sb.append(" " + this.valStr(this.operand1));
            sb.append(", label " + this.targetLabel + ", label " + this.falseLabel);
        } else if (this.opcode == IROpCode.RET) {
            if (this.operand1 != null) {
                sb.append(" " + this.valStr(this.operand1));
            }
        } else if (this.opcode == IROpCode.CALL) {
            sb.append(" @" + this.calleeName + "(");
            if (this.args != null) {
                for (int i = 0; i < this.args.size(); i++) {
                    if (i > 0) sb.append(", ");
                    sb.append(this.valStr(this.args.get(i)));
                }
            }
            sb.append(")");
        } else if (this.opcode == IROpCode.ALLOCA) {
            sb.append(" " + this.allocaSize);
        } else if (this.opcode == IROpCode.GEP) {
            sb.append(" " + this.valStr(this.operand1) + ", " + this.gepIndex);
        } else if (this.opcode == IROpCode.PHI) {
            if (this.phiEntries != null) {
                for (int i = 0; i < this.phiEntries.size(); i++) {
                    if (i > 0) sb.append(", ");
                    IRPhiEntry entry = this.phiEntries.get(i);
                    sb.append("[" + this.valStr(entry.value) + ", " + entry.label + "]");
                }
            }
        } else if (this.opcode == IROpCode.STORE) {
            sb.append(" " + this.valStr(this.operand1));
            sb.append(", " + this.valStr(this.operand2));
        } else if (this.opcode == IROpCode.SELECT) {
            sb.append(" " + this.valStr(this.operand1));
            sb.append(", " + this.valStr(this.operand2));
            sb.append(", " + this.valStr(this.operand3));
        } else {
            if (this.operand1 != null) sb.append(" " + this.valStr(this.operand1));
            if (this.operand2 != null) sb.append(", " + this.valStr(this.operand2));
        }

        // 类型后缀
        if (this.resultType != null && this.hasResult()) {
            sb.append(" : " + this.resultType.toString());
        }
        return sb.toString();
    }

    private String valStr(IRValue v) {
        if (v == null) return "_";
        return v.name;
    }
}

// Phi 条目
class IRPhiEntry {
    public IRValue value;
    public String label;

    public IRPhiEntry(IRValue value, String label) {
        this.value = value;
        this.label = label;
    }
}
