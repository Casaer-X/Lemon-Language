package lemon.ir;

import lemon.ir.IRType;
import lemon.ir.IR;

// ============================================================
// IR 函数与模块结构
// ============================================================

// IR 函数参数
class IRParam {
    public String name;
    public IRType type;

    public IRParam(String name, IRType type) {
        this.name = name;
        this.type = type;
    }
}

// IR 函数
class IRFunction {
    public String name;
    public IRType returnType;
    public Array<IRParam> params;
    public Array<IRBasicBlock> blocks;
    public Array<String> localVars;       // 局部变量名列表
    public int nextValueId;               // 下一个值 ID
    public bool isExternal;

    public IRFunction(String name, IRType returnType) {
        this.name = name;
        this.returnType = returnType;
        this.params = new Array<IRParam>();
        this.blocks = new Array<IRBasicBlock>();
        this.localVars = new Array<String>();
        this.nextValueId = 0;
        this.isExternal = false;
    }

    public void addParam(String name, IRType type) {
        this.params.add(new IRParam(name, type));
    }

    public IRBasicBlock addBlock(String label) {
        IRBasicBlock block = new IRBasicBlock(label);
        this.blocks.add(block);
        return block;
    }

    public IRBasicBlock getEntryBlock() {
        if (this.blocks.size() > 0) return this.blocks.get(0);
        return null;
    }

    public IRBasicBlock getCurrentBlock() {
        if (this.blocks.size() > 0) return this.blocks.get(this.blocks.size() - 1);
        return null;
    }

    public String newValueName() {
        int id = this.nextValueId;
        this.nextValueId = this.nextValueId + 1;
        return "%" + id;
    }

    public IRValue newValue(IRType type) {
        String name = this.newValueName();
        IRValue val = new IRValue(this.nextValueId - 1, name, type);
        return val;
    }

    // ---- 便捷指令构建方法 ----

    public IRValue emitConstInt(IRType type, long value) {
        IRInstruction inst = new IRInstruction(IROpCode.CONST_INT);
        inst.resultType = type;
        inst.resultName = this.newValueName();
        inst.intImm = value;
        IRBasicBlock curBlock = this.getCurrentBlock();
        curBlock.addInstruction(inst);
        return new IRValue(this.nextValueId - 1, inst.resultName, type);
    }

    public IRValue emitConstFloat(IRType type, double value) {
        IRInstruction inst = new IRInstruction(IROpCode.CONST_FLOAT);
        inst.resultType = type;
        inst.resultName = this.newValueName();
        inst.floatImm = value;
        IRBasicBlock curBlock = this.getCurrentBlock();
        curBlock.addInstruction(inst);
        return new IRValue(this.nextValueId - 1, inst.resultName, type);
    }

    public IRValue emitConstBool(bool value) {
        IRInstruction inst = new IRInstruction(IROpCode.CONST_BOOL);
        inst.resultType = IRType.boolType();
        inst.resultName = this.newValueName();
        inst.boolImm = value;
        IRBasicBlock curBlock = this.getCurrentBlock();
        curBlock.addInstruction(inst);
        return new IRValue(this.nextValueId - 1, inst.resultName, IRType.boolType());
    }

    public IRValue emitConstNull(IRType type) {
        IRInstruction inst = new IRInstruction(IROpCode.CONST_NULL);
        inst.resultType = type;
        inst.resultName = this.newValueName();
        IRBasicBlock curBlock = this.getCurrentBlock();
        curBlock.addInstruction(inst);
        return new IRValue(this.nextValueId - 1, inst.resultName, type);
    }

    public IRValue emitConstStr(String value) {
        IRInstruction inst = new IRInstruction(IROpCode.CONST_STR);
        inst.resultType = IRType.ptr(IRType.i8());
        inst.resultName = this.newValueName();
        inst.strValue = value;
        IRBasicBlock curBlock = this.getCurrentBlock();
        curBlock.addInstruction(inst);
        return new IRValue(this.nextValueId - 1, inst.resultName, IRType.ptr(IRType.i8()));
    }

    public IRValue emitBinOp(int opcode, IRType type, IRValue lhs, IRValue rhs) {
        IRInstruction inst = new IRInstruction(opcode);
        inst.resultType = type;
        inst.resultName = this.newValueName();
        inst.operand1 = lhs;
        inst.operand2 = rhs;
        IRBasicBlock curBlock = this.getCurrentBlock();
        curBlock.addInstruction(inst);
        return new IRValue(this.nextValueId - 1, inst.resultName, type);
    }

    public IRValue emitNeg(IRType type, IRValue val) {
        IRInstruction inst = new IRInstruction(IROpCode.NEG);
        inst.resultType = type;
        inst.resultName = this.newValueName();
        inst.operand1 = val;
        IRBasicBlock curBlock = this.getCurrentBlock();
        curBlock.addInstruction(inst);
        return new IRValue(this.nextValueId - 1, inst.resultName, type);
    }

    public IRValue emitNot(IRType type, IRValue val) {
        IRInstruction inst = new IRInstruction(IROpCode.NOT);
        inst.resultType = type;
        inst.resultName = this.newValueName();
        inst.operand1 = val;
        IRBasicBlock curBlock = this.getCurrentBlock();
        curBlock.addInstruction(inst);
        return new IRValue(this.nextValueId - 1, inst.resultName, type);
    }

    public IRValue emitCmp(int opcode, IRValue lhs, IRValue rhs) {
        IRInstruction inst = new IRInstruction(opcode);
        inst.resultType = IRType.boolType();
        inst.resultName = this.newValueName();
        inst.operand1 = lhs;
        inst.operand2 = rhs;
        IRBasicBlock curBlock = this.getCurrentBlock();
        curBlock.addInstruction(inst);
        return new IRValue(this.nextValueId - 1, inst.resultName, IRType.boolType());
    }

    public IRValue emitAlloca(IRType type, int size) {
        IRInstruction inst = new IRInstruction(IROpCode.ALLOCA);
        inst.resultType = IRType.ptr(type);
        inst.resultName = this.newValueName();
        inst.allocaSize = size;
        IRBasicBlock curBlock = this.getCurrentBlock();
        curBlock.addInstruction(inst);
        return new IRValue(this.nextValueId - 1, inst.resultName, IRType.ptr(type));
    }

    public IRValue emitLoad(IRType type, IRValue ptr) {
        IRInstruction inst = new IRInstruction(IROpCode.LOAD);
        inst.resultType = type;
        inst.resultName = this.newValueName();
        inst.operand1 = ptr;
        IRBasicBlock curBlock = this.getCurrentBlock();
        curBlock.addInstruction(inst);
        return new IRValue(this.nextValueId - 1, inst.resultName, type);
    }

    public void emitStore(IRValue value, IRValue ptr) {
        IRInstruction inst = new IRInstruction(IROpCode.STORE);
        inst.operand1 = value;
        inst.operand2 = ptr;
        IRBasicBlock curBlock = this.getCurrentBlock();
        curBlock.addInstruction(inst);
    }

    public IRValue emitGEP(IRType type, IRValue ptr, int index) {
        IRInstruction inst = new IRInstruction(IROpCode.GEP);
        inst.resultType = IRType.ptr(type);
        inst.resultName = this.newValueName();
        inst.operand1 = ptr;
        inst.gepIndex = index;
        IRBasicBlock curBlock = this.getCurrentBlock();
        curBlock.addInstruction(inst);
        return new IRValue(this.nextValueId - 1, inst.resultName, IRType.ptr(type));
    }

    public void emitBr(String label) {
        IRInstruction inst = new IRInstruction(IROpCode.BR);
        inst.targetLabel = label;
        IRBasicBlock curBlock = this.getCurrentBlock();
        curBlock.addInstruction(inst);
    }

    public void emitCondBr(IRValue cond, String trueLabel, String falseLabel) {
        IRInstruction inst = new IRInstruction(IROpCode.CONDBR);
        inst.operand1 = cond;
        inst.targetLabel = trueLabel;
        inst.falseLabel = falseLabel;
        IRBasicBlock curBlock = this.getCurrentBlock();
        curBlock.addInstruction(inst);
    }

    public IRValue emitCall(IRType returnType, String callee, Array<IRValue> args) {
        IRInstruction inst = new IRInstruction(IROpCode.CALL);
        inst.resultType = returnType;
        inst.resultName = this.newValueName();
        inst.calleeName = callee;
        inst.args = args;
        IRBasicBlock curBlock = this.getCurrentBlock();
        curBlock.addInstruction(inst);
        return new IRValue(this.nextValueId - 1, inst.resultName, returnType);
    }

    public void emitRet(IRValue val) {
        IRInstruction inst = new IRInstruction(IROpCode.RET);
        inst.operand1 = val;
        IRBasicBlock curBlock = this.getCurrentBlock();
        curBlock.addInstruction(inst);
    }

    public void emitRetVoid() {
        IRInstruction inst = new IRInstruction(IROpCode.RET);
        IRBasicBlock curBlock = this.getCurrentBlock();
        curBlock.addInstruction(inst);
    }

    public IRValue emitCast(int opcode, IRType destType, IRValue val) {
        IRInstruction inst = new IRInstruction(opcode);
        inst.resultType = destType;
        inst.resultName = this.newValueName();
        inst.operand1 = val;
        IRBasicBlock curBlock = this.getCurrentBlock();
        curBlock.addInstruction(inst);
        return new IRValue(this.nextValueId - 1, inst.resultName, destType);
    }

    public IRValue emitSelect(IRValue cond, IRValue trueVal, IRValue falseVal) {
        IRInstruction inst = new IRInstruction(IROpCode.SELECT);
        inst.resultType = trueVal.type;
        inst.resultName = this.newValueName();
        inst.operand1 = cond;
        inst.operand2 = trueVal;
        inst.operand3 = falseVal;
        IRBasicBlock curBlock = this.getCurrentBlock();
        curBlock.addInstruction(inst);
        return new IRValue(this.nextValueId - 1, inst.resultName, trueVal.type);
    }

    // ---- 转储 ----

    public String dump() {
        StringBuilder sb = new StringBuilder();
        sb.append("define " + this.returnType.toString() + " @" + this.name + "(");
        for (int i = 0; i < this.params.size(); i++) {
            if (i > 0) sb.append(", ");
            IRParam param = this.params.get(i);
            IRType paramType = param.type;
            String paramName = param.name;
            sb.append(paramType.toString() + " " + paramName);
        }
        sb.append(") {\n");

        for (int bi = 0; bi < this.blocks.size(); bi++) {
            IRBasicBlock block = this.blocks.get(bi);
            sb.append("  " + block.label + ":\n");
            for (int ii = 0; ii < block.instructions.size(); ii++) {
                IRInstruction inst = block.instructions.get(ii);
                sb.append("    " + inst.toString() + "\n");
            }
        }

        sb.append("}\n");
        return sb.toString();
    }
}

// IR 模块
class IRModule {
    public String name;
    public Array<IRFunction> functions;
    public Array<String> stringPool;
    public Array<IRStructDef> structDefs;

    public IRModule(String name) {
        this.name = name;
        this.functions = new Array<IRFunction>();
        this.stringPool = new Array<String>();
        this.structDefs = new Array<IRStructDef>();
    }

    public IRFunction addFunction(String name, IRType returnType) {
        IRFunction func = new IRFunction(name, returnType);
        this.functions.add(func);
        return func;
    }

    public IRFunction findFunction(String name) {
        for (int i = 0; i < this.functions.size(); i++) {
            IRFunction func = this.functions.get(i);
            String funcName = func.name;
            if (funcName.equals(name)) {
                return func;
            }
        }
        return null;
    }

    public int addString(String str) {
        for (int i = 0; i < this.stringPool.size(); i++) {
            String poolStr = this.stringPool.get(i);
            if (poolStr.equals(str)) return i;
        }
        this.stringPool.add(str);
        return this.stringPool.size() - 1;
    }

    public void addStructDef(IRStructDef def) {
        this.structDefs.add(def);
    }

    // ---- 转储 ----

    public String dump() {
        StringBuilder sb = new StringBuilder();
        sb.append("; IR Module: " + this.name + "\n\n");

        // 结构体定义
        for (int i = 0; i < this.structDefs.size(); i++) {
            IRStructDef def = this.structDefs.get(i);
            sb.append(def.dump());
            sb.append("\n");
        }

        // 字符串池
        if (this.stringPool.size() > 0) {
            sb.append("; String Pool:\n");
            for (int i = 0; i < this.stringPool.size(); i++) {
                String poolStr = this.stringPool.get(i);
                sb.append(";   " + i + ": \"" + poolStr + "\"\n");
            }
            sb.append("\n");
        }

        // 函数定义
        for (int i = 0; i < this.functions.size(); i++) {
            IRFunction func = this.functions.get(i);
            sb.append(func.dump());
            sb.append("\n");
        }

        return sb.toString();
    }
}

// IR 结构体定义
class IRStructDef {
    public String name;
    public Array<String> fieldNames;
    public Array<IRType> fieldTypes;

    public IRStructDef(String name) {
        this.name = name;
        this.fieldNames = new Array<String>();
        this.fieldTypes = new Array<IRType>();
    }

    public void addField(String name, IRType type) {
        this.fieldNames.add(name);
        this.fieldTypes.add(type);
    }

    public int getFieldIndex(String name) {
        for (int i = 0; i < this.fieldNames.size(); i++) {
            String fieldName = this.fieldNames.get(i);
            if (fieldName.equals(name)) return i;
        }
        return -1;
    }

    public int sizeInBytes() {
        int size = 0;
        for (int i = 0; i < this.fieldTypes.size(); i++) {
            IRType fieldType = this.fieldTypes.get(i);
            size = size + fieldType.sizeInBytes();
        }
        return size;
    }

    public String dump() {
        StringBuilder sb = new StringBuilder();
        sb.append("%" + this.name + " = type { ");
        for (int i = 0; i < this.fieldTypes.size(); i++) {
            if (i > 0) sb.append(", ");
            IRType fieldType = this.fieldTypes.get(i);
            sb.append(fieldType.toString());
        }
        sb.append(" }\n");
        return sb.toString();
    }
}
