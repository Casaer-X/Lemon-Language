package lemon.runtime;

// ============================================================
// Lemon 原生运行时库
// 提供内存管理、数组操作、字符串操作、I/O 等运行时函数
// 这些函数在原生代码生成和 JIT 编译时作为外部调用目标
// ============================================================

// 运行时函数注册表
class Runtime {
    // 运行时函数名列表
    private Array<String> funcNames;
    // 运行时函数签名 (参数数量)
    private Array<int> funcParamCounts;
    // 运行时函数签名 (返回类型: 0=void, 1=int, 2=long, 3=float, 4=ptr)
    private Array<int> funcReturnTypes;

    public Runtime() {
        this.funcNames = new Array<String>();
        this.funcParamCounts = new Array<int>();
        this.funcReturnTypes = new Array<int>();

        this.initBuiltinFunctions();
    }

    private void initBuiltinFunctions() {
        // ---- 内存管理 ----
        this.register("LemonRuntime_alloc", 1, 4);        // 分配内存
        this.register("LemonRuntime_realloc", 2, 4);      // 重新分配
        this.register("LemonRuntime_free", 1, 0);          // 释放内存
        this.register("LemonRuntime_memcpy", 3, 0);        // 内存拷贝
        this.register("LemonRuntime_memset", 3, 0);        // 内存设置

        // ---- 数组操作 ----
        this.register("LemonRuntime_arrayNew", 1, 4);      // 创建数组
        this.register("LemonRuntime_arrayLen", 1, 2);      // 数组长度
        this.register("LemonRuntime_arrayGet", 2, 4);      // 数组取值
        this.register("LemonRuntime_arraySet", 3, 0);      // 数组赋值
        this.register("LemonRuntime_arrayPush", 2, 0);     // 数组追加
        this.register("LemonRuntime_arrayPop", 1, 4);      // 数组弹出
        this.register("LemonRuntime_arrayInsert", 3, 0);   // 数组插入
        this.register("LemonRuntime_arrayRemove", 2, 4);   // 数组删除

        // ---- 字符串操作 ----
        this.register("LemonRuntime_strNew", 1, 4);        // 创建字符串
        this.register("LemonRuntime_strLen", 1, 2);        // 字符串长度
        this.register("LemonRuntime_strConcat", 2, 4);     // 字符串连接
        this.register("LemonRuntime_strEquals", 2, 1);     // 字符串比较
        this.register("LemonRuntime_strSubstring", 3, 4);  // 子字符串
        this.register("LemonRuntime_strIndexOf", 2, 2);    // 查找子串
        this.register("LemonRuntime_strCharAt", 2, 2);     // 字符访问
        this.register("LemonRuntime_strToInt", 1, 2);      // 字符串转整数
        this.register("LemonRuntime_strFromInt", 1, 4);    // 整数转字符串

        // ---- I/O 操作 ----
        this.register("LemonRuntime_printInt", 1, 0);      // 打印整数
        this.register("LemonRuntime_printLong", 1, 0);     // 打印长整数
        this.register("LemonRuntime_printFloat", 1, 0);    // 打印浮点数
        this.register("LemonRuntime_printString", 1, 0);   // 打印字符串
        this.register("LemonRuntime_printBool", 1, 0);     // 打印布尔值
        this.register("LemonRuntime_println", 0, 0);       // 打印换行
        this.register("LemonRuntime_readLine", 0, 4);      // 读取一行

        // ---- 类型操作 ----
        this.register("LemonRuntime_instanceof", 2, 1);    // 类型检查
        this.register("LemonRuntime_cast", 2, 4);          // 类型转换
        this.register("LemonRuntime_getType", 1, 2);       // 获取类型 ID

        // ---- 对象操作 ----
        this.register("LemonRuntime_objNew", 2, 4);        // 创建对象
        this.register("LemonRuntime_objGetField", 2, 4);   // 获取字段
        this.register("LemonRuntime_objSetField", 3, 0);   // 设置字段
        this.register("LemonRuntime_objGetMethod", 2, 4);  // 获取方法

        // ---- Map 操作 ----
        this.register("LemonRuntime_mapNew", 0, 4);        // 创建 Map
        this.register("LemonRuntime_mapGet", 2, 4);        // Map 取值
        this.register("LemonRuntime_mapPut", 3, 0);        // Map 赋值
        this.register("LemonRuntime_mapContains", 2, 1);   // Map 包含
        this.register("LemonRuntime_mapLen", 1, 2);        // Map 长度
        this.register("LemonRuntime_mapRemove", 2, 4);     // Map 删除
        this.register("LemonRuntime_mapKeys", 1, 4);       // Map 键列表
    }

    private void register(String name, int paramCount, int returnType) {
        this.funcNames.add(name);
        this.funcParamCounts.add(paramCount);
        this.funcReturnTypes.add(returnType);
    }

    // ---- 查询方法 ----

    public int getFunctionCount() {
        return this.funcNames.size();
    }

    public String getFunctionName(int index) {
        if (index >= 0 && index < this.funcNames.size()) {
            return this.funcNames.get(index);
        }
        return "";
    }

    public int getParamCount(int index) {
        if (index >= 0 && index < this.funcParamCounts.size()) {
            return this.funcParamCounts.get(index);
        }
        return 0;
    }

    public int getReturnType(int index) {
        if (index >= 0 && index < this.funcReturnTypes.size()) {
            return this.funcReturnTypes.get(index);
        }
        return 0;
    }

    public int findFunction(String name) {
        for (int i = 0; i < this.funcNames.size(); i++) {
            String funcName = this.funcNames.get(i);
            if (funcName.equals(name)) {
                return i;
            }
        }
        return -1;
    }

    public bool isRuntimeFunction(String name) {
        return this.findFunction(name) >= 0;
    }

    // ---- 获取所有函数名 ----

    public Array<String> getAllFunctionNames() {
        Array<String> names = new Array<String>();
        for (int i = 0; i < this.funcNames.size(); i++) {
            names.add(this.funcNames.get(i));
        }
        return names;
    }

    // ---- 生成 C 运行时头文件 ----

    public String generateCHeader() {
        StringBuilder sb = new StringBuilder();
        sb.append("// Lemon Runtime - Auto-generated header\n");
        sb.append("#ifndef LEMON_RUNTIME_H\n");
        sb.append("#define LEMON_RUNTIME_H\n\n");
        sb.append("#include <stdint.h>\n");
        sb.append("#include <stdlib.h>\n");
        sb.append("#include <string.h>\n");
        sb.append("#include <stdio.h>\n\n");

        for (int i = 0; i < this.funcNames.size(); i++) {
            String name = this.funcNames.get(i);
            int retType = this.funcReturnTypes.get(i);
            int paramCount = this.funcParamCounts.get(i);

            String retStr = this.cReturnType(retType);
            sb.append(retStr + " " + name + "(");
            if (paramCount == 0) {
                sb.append("void");
            } else {
                for (int p = 0; p < paramCount; p++) {
                    if (p > 0) sb.append(", ");
                    sb.append("void* arg" + p);
                }
            }
            sb.append(");\n");
        }

        sb.append("\n#endif // LEMON_RUNTIME_H\n");
        return sb.toString();
    }

    private String cReturnType(int type) {
        if (type == 0) return "void";
        if (type == 1) return "int32_t";
        if (type == 2) return "int64_t";
        if (type == 3) return "double";
        if (type == 4) return "void*";
        return "void*";
    }

    // ---- 生成 C 运行时实现 ----

    public String generateCImplementation() {
        StringBuilder sb = new StringBuilder();
        sb.append("// Lemon Runtime - Auto-generated implementation\n\n");
        sb.append("#include \"runtime.h\"\n\n");

        // 内存管理实现
        sb.append("void* LemonRuntime_alloc(int64_t size) {\n");
        sb.append("    return malloc((size_t)size);\n");
        sb.append("}\n\n");

        sb.append("void* LemonRuntime_realloc(void* ptr, int64_t size) {\n");
        sb.append("    return realloc(ptr, (size_t)size);\n");
        sb.append("}\n\n");

        sb.append("void LemonRuntime_free(void* ptr) {\n");
        sb.append("    free(ptr);\n");
        sb.append("}\n\n");

        sb.append("void LemonRuntime_memcpy(void* dst, void* src, int64_t size) {\n");
        sb.append("    memcpy(dst, src, (size_t)size);\n");
        sb.append("}\n\n");

        sb.append("void LemonRuntime_memset(void* dst, int32_t val, int64_t size) {\n");
        sb.append("    memset(dst, val, (size_t)size);\n");
        sb.append("}\n\n");

        // I/O 实现
        sb.append("void LemonRuntime_printInt(int64_t val) {\n");
        sb.append("    printf(\"%lld\", (long long)val);\n");
        sb.append("}\n\n");

        sb.append("void LemonRuntime_printFloat(double val) {\n");
        sb.append("    printf(\"%g\", val);\n");
        sb.append("}\n\n");

        sb.append("void LemonRuntime_printString(void* str) {\n");
        sb.append("    if (str) printf(\"%s\", (const char*)str);\n");
        sb.append("}\n\n");

        sb.append("void LemonRuntime_printBool(int32_t val) {\n");
        sb.append("    printf(\"%s\", val ? \"true\" : \"false\");\n");
        sb.append("}\n\n");

        sb.append("void LemonRuntime_println(void) {\n");
        sb.append("    printf(\"\\n\");\n");
        sb.append("}\n\n");

        sb.append("void* LemonRuntime_readLine(void) {\n");
        sb.append("    char buf[4096];\n");
        sb.append("    if (fgets(buf, sizeof(buf), stdin)) {\n");
        sb.append("        size_t len = strlen(buf);\n");
        sb.append("        if (len > 0 && buf[len-1] == '\\n') buf[len-1] = '\\0';\n");
        sb.append("        return strdup(buf);\n");
        sb.append("    }\n");
        sb.append("    return NULL;\n");
        sb.append("}\n\n");

        // 字符串操作实现
        sb.append("void* LemonRuntime_strNew(void* init) {\n");
        sb.append("    if (!init) return strdup(\"\");\n");
        sb.append("    return strdup((const char*)init);\n");
        sb.append("}\n\n");

        sb.append("int64_t LemonRuntime_strLen(void* str) {\n");
        sb.append("    if (!str) return 0;\n");
        sb.append("    return (int64_t)strlen((const char*)str);\n");
        sb.append("}\n\n");

        sb.append("void* LemonRuntime_strConcat(void* a, void* b) {\n");
        sb.append("    const char* sa = a ? (const char*)a : \"\";\n");
        sb.append("    const char* sb = b ? (const char*)b : \"\";\n");
        sb.append("    size_t la = strlen(sa), lb = strlen(sb);\n");
        sb.append("    char* result = (char*)malloc(la + lb + 1);\n");
        sb.append("    memcpy(result, sa, la);\n");
        sb.append("    memcpy(result + la, sb, lb + 1);\n");
        sb.append("    return result;\n");
        sb.append("}\n\n");

        sb.append("int32_t LemonRuntime_strEquals(void* a, void* b) {\n");
        sb.append("    const char* sa = a ? (const char*)a : \"\";\n");
        sb.append("    const char* sb = b ? (const char*)b : \"\";\n");
        sb.append("    return strcmp(sa, sb) == 0;\n");
        sb.append("}\n\n");

        sb.append("int64_t LemonRuntime_strToInt(void* str) {\n");
        sb.append("    if (!str) return 0;\n");
        sb.append("    return atoll((const char*)str);\n");
        sb.append("}\n\n");

        sb.append("void* LemonRuntime_strFromInt(int64_t val) {\n");
        sb.append("    char buf[32];\n");
        sb.append("    snprintf(buf, sizeof(buf), \"%lld\", (long long)val);\n");
        sb.append("    return strdup(buf);\n");
        sb.append("}\n\n");

        return sb.toString();
    }

    // ---- 调试输出 ----

    public String dump() {
        StringBuilder sb = new StringBuilder();
        sb.append("; Lemon Runtime Functions (" + this.funcNames.size() + ")\n");
        for (int i = 0; i < this.funcNames.size(); i++) {
            String name = this.funcNames.get(i);
            int params = this.funcParamCounts.get(i);
            int retType = this.funcReturnTypes.get(i);
            String retStr = this.typeName(retType);
            sb.append("  " + i + ": " + retStr + " " + name + "(" + params + " args)\n");
        }
        return sb.toString();
    }

    private String typeName(int type) {
        if (type == 0) return "void";
        if (type == 1) return "int";
        if (type == 2) return "long";
        if (type == 3) return "float";
        if (type == 4) return "ptr";
        return "?";
    }
}
