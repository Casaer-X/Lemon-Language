package lemon;

import lemon.lexer.Span;
import lemon.lexer.TokenKind;
import lemon.lexer.Token;
import lemon.lexer.Lexer;
import lemon.parser.AST;
import lemon.parser.Parser;
import lemon.semantic.SemanticError;
import lemon.semantic.SemanticAnalyzer;
import lemon.ast.Optimizer;
import lemon.codegen.CCodeGen;
import lemon.codegen.NasmCodeGen;
import lemon.codegen.NativeCodeGen;
import lemon.codegen.COFF64;
import lemon.codegen.PELinker;
import lemon.jit.BytecodeCompiler;
import lemon.jit.LeVM;
import lemon.jit.JitCompiler;
import lemon.ir.IRGen;
import lemon.ast.ExecutionStrategy;
import lemon.runtime.Runtime;

class LemonCompiler {

    // Recursively scan a directory for .lm files (excluding test files)
    private static Array<String> scanDir(String dirPath, Array<String> results) {
        Array<String> entries = File.listDir(dirPath);
        if (entries == null) return results;
        for (int i = 0; i < entries.size(); i++) {
            String name = (String)entries.get(i);
            // Skip hidden dirs and common non-source dirs
            if (name.startsWith(".") || name.equals("target") || name.equals("build") ||
                name.equals("build_t1") || name.equals("build_t2") || name.equals("build_t3") ||
                name.equals("output")) {
                continue;
            }
            String fullPath = dirPath + "/" + name;
            if (File.isDir(fullPath)) {
                LemonCompiler.scanDir(fullPath, results);
            } else if (name.endsWith(".lm")) {
                // Skip test files (files starting with "test_" or ending with "Test.lm")
                if (name.startsWith("test_") || name.endsWith("Test.lm")) {
                    continue;
                }
                results.add(fullPath);
            }
        }
        return results;
    }

    // Compile a list of source files into C code
    private static int compileFiles(Array<String> inputFiles, String outputFile, String target) {
        // Default output file
        if (outputFile == null) {
            String first = inputFiles.get(0);
            if (first.endsWith(".lm")) {
                outputFile = first.substring(0, first.length() - 3) + ".c";
            } else {
                outputFile = first + ".c";
            }
        }

        // Adjust output file extension based on target
        if (target.equals("nasm") && outputFile.endsWith(".c")) {
            outputFile = outputFile.substring(0, outputFile.length() - 2) + ".asm";
        } else if (target.equals("bytecode") && outputFile.endsWith(".c")) {
            outputFile = outputFile.substring(0, outputFile.length() - 2) + ".lmb";
        }

        // Collect all declarations from all input files
        Array<Declaration> allDeclarations = new Array<Declaration>();
        int totalTokens = 0;
        Map<String, String> annotations = new Map<String, String>();

        for (int fi = 0; fi < inputFiles.size(); fi++) {
            String inputFile = inputFiles.get(fi);

            // Read source file
            String source = File.readAll(inputFile);
            if (source == null) {
                System.printf("Error: cannot read file '%s'\n", inputFile);
                return 1;
            }

            // Phase 1: Lexical analysis
            System.printf("[1/5] Lexical analysis (%d/%d)...\n", fi + 1, inputFiles.size());
            Lexer lexer = new Lexer(source);
            Array<Token> tokens = lexer.tokenize();
            totalTokens = totalTokens + tokens.size();

            // Collect compile annotations from this file
            Array<String> fileAnnotations = lexer.getCompileAnnotations();
            for (int ai = 0; ai < fileAnnotations.size(); ai++) {
                String ann = fileAnnotations.get(ai);
                // Parse key=value annotation
                int eqIdx = String.indexOf(ann, "=");
                if (eqIdx > 0) {
                    String key = String.trim(ann->substring(0, eqIdx));
                    String val = String.trim(ann->substring(eqIdx + 1));
                    annotations.put(key, val);
                }
            }

            // Phase 2: Parsing
            System.printf("[2/5] Parsing (%d/%d)...\n", fi + 1, inputFiles.size());
            Parser parser = new Parser(tokens);
            Program program = parser.parse();
            if (parser.hasErrors()) {
                Array<String> parseErrors = parser.getErrors();
                for (int i = 0; i < parseErrors.size(); i++) {
                    System.printf("  Parse error: %s\n", parseErrors.get(i));
                }
                System.printf("  Parsing failed with %d errors\n", parseErrors.size());
                return 1;
            }

            for (int di = 0; di < program.declarations.size(); di++) {
                allDeclarations.add(program.declarations.get(di));
            }
        }

        System.printf("  Tokenized %d tokens (total from %d files)\n", totalTokens, inputFiles.size());
        System.printf("  Parsed %d declarations (total)\n", allDeclarations.size());

        // Build combined program
        Program combined = new Program(allDeclarations);

        // Phase 2.5: Semantic analysis
        System.printf("[2.5/5] Semantic analysis...\n");
        SemanticAnalyzer semantic = new SemanticAnalyzer();
        semantic.analyze(combined);
        Array<SemanticError> semErrors = semantic.getErrors();
        Array<String> semWarnings = semantic.getWarnings();
        if (semWarnings.size() > 0) {
            for (int i = 0; i < semWarnings.size(); i++) {
                System.printf("  [Warning] %s\n", semWarnings.get(i));
            }
        }
        if (semErrors.size() > 0) {
            for (int i = 0; i < semErrors.size(); i++) {
                SemanticError err = semErrors.get(i);
                System.printf("  [Error] %s\n", err.toString());
            }
            System.printf("  Semantic analysis failed with %d errors\n", semErrors.size());
            return 1;
        }
        System.printf("  Semantic analysis passed");
        if (semWarnings.size() > 0) {
            System.printf(" (%d warnings)", semWarnings.size());
        }
        System.printf("\n");

        // Phase 3: Optimization
        System.printf("[3/5] Optimizing...\n");
        Optimizer optimizer = new Optimizer();
        optimizer.optimize(combined);
        OptimizerStats optStats = optimizer.getStats();
        System.printf("  Constants folded: %d\n", optStats.constantsFolded);
        System.printf("  Constants propagated: %d\n", optStats.constantsPropagated);
        System.printf("  Dead code removed: %d\n", optStats.deadCodeRemoved);

        // Phase 4: Code generation (dispatch by target)
        // Apply annotations that override target
        if (annotations.containsKey("target")) {
            String annTarget = annotations.get("target");
            if (!annTarget.equals(target)) {
                System.printf("  Annotation overrides target: %s -> %s\n", target, annTarget);
                target = annTarget;
            }
        }
        System.printf("[4/5] Generating code (target: %s)...\n", target);
        String outputCode = null;

        if (target.equals("c")) {
            CCodeGen codegen = new CCodeGen();
            outputCode = codegen.generate(combined);
        } else if (target.equals("nasm")) {
            NasmCodeGen nasmGen = new NasmCodeGen();
            outputCode = nasmGen.generate(combined);
        } else if (target.equals("native")) {
            NativeCodeGen nativeGen = new NativeCodeGen();
            NativeModule nativeModule = nativeGen.generate(combined);
            // 生成 COFF64 目标文件
            COFF64 coff = new COFF64();
            coff.buildFromNativeModule(nativeModule);
            // 输出原生模块的可读文本表示 + COFF 信息
            outputCode = this.dumpNativeModule(nativeModule);
            outputCode = outputCode + "\n" + coff.dump();
            // 同时输出 .obj 文件
            String objFile = outputFile;
            if (objFile.endsWith(".c")) {
                objFile = objFile.substring(0, objFile.length() - 2) + ".obj";
            } else if (objFile.endsWith(".asm")) {
                objFile = objFile.substring(0, objFile.length() - 4) + ".obj";
            }
            Array<int> objBytes = coff.serialize();
            this.dumpObjFile(objFile, objBytes);
            // 生成 PE32+ 可执行文件
            PELinker peLinker = new PELinker();
            peLinker.addNativeModule(nativeModule);
            outputCode = outputCode + "\n" + peLinker.dump();
            String exeFile = outputFile;
            if (exeFile.endsWith(".c")) {
                exeFile = exeFile.substring(0, exeFile.length() - 2) + ".exe";
            } else if (exeFile.endsWith(".asm")) {
                exeFile = exeFile.substring(0, exeFile.length() - 4) + ".exe";
            }
            Array<int> peBytes = peLinker.buildPE();
            this.dumpObjFile(exeFile, peBytes);
        } else if (target.equals("bytecode")) {
            BytecodeCompiler bcCompiler = new BytecodeCompiler();
            BytecodeModule bcModule = bcCompiler.compile(combined);
            // 输出字节码的可读文本表示
            outputCode = this.dumpBytecodeModule(bcModule);
            // 同时输出 VM 状态信息
            outputCode = outputCode + "\n; VM Info: " + bcModule.functions.size() + " functions, " + bcModule.classes.size() + " classes\n";
            // JIT 编译热点函数
            JitCompiler jitCompiler = new JitCompiler();
            JitState jitState = new JitState();
            jitState.hotThreshold = 1; // 编译所有函数
            jitCompiler.compileModule(bcModule, jitState);
            outputCode = outputCode + "\n; JIT: " + jitState.compiledFunctions.size() + " functions compiled\n";
            for (int ji = 0; ji < jitState.compiledFunctions.size(); ji++) {
                JitCompiledFunction jf = jitState.compiledFunctions.get(ji);
                outputCode = outputCode + jitCompiler.dumpFunction(jf);
            }
        } else if (target.equals("ir")) {
            // IR 中间表示生成
            IRGen irGen = new IRGen();
            IRModule irModule = irGen.generate(combined);
            outputCode = irModule.dump();
        } else if (target.equals("hybrid")) {
            // 混合执行: 分析策略 + AOT + JIT + 字节码
            ExecutionStrategyAnalyzer strategyAnalyzer = new ExecutionStrategyAnalyzer();
            strategyAnalyzer.analyze(combined);

            // AOT 部分: 编译 AOT 函数为原生代码
            NativeCodeGen nativeGen = new NativeCodeGen();
            NativeModule nativeModule = nativeGen.generate(combined);

            // 字节码部分: 编译所有函数为字节码
            BytecodeCompiler bcCompiler = new BytecodeCompiler();
            BytecodeModule bcModule = bcCompiler.compile(combined);

            // JIT 部分: 编译热点函数
            JitCompiler jitCompiler = new JitCompiler();
            JitState jitState = new JitState();
            jitState.hotThreshold = 1;
            jitCompiler.compileModule(bcModule, jitState);

            // 运行时库信息
            Runtime runtime = new Runtime();

            // PE 链接
            PELinker peLinker = new PELinker();
            peLinker.addNativeModule(nativeModule);

            // 输出混合执行信息
            outputCode = "; === Hybrid Execution Module ===\n";
            outputCode = outputCode + strategyAnalyzer.dump();
            outputCode = outputCode + "\n; Runtime:\n" + runtime.dump();
            outputCode = outputCode + "\n; Native Module:\n" + this.dumpNativeModule(nativeModule);
            outputCode = outputCode + "\n; Bytecode Module:\n" + this.dumpBytecodeModule(bcModule);
            outputCode = outputCode + "\n; JIT: " + jitState.compiledFunctions.size() + " functions compiled\n";
            outputCode = outputCode + "\n; PE Linker:\n" + peLinker.dump();
        } else {
            System.printf("Error: Unknown target '%s'\n", target);
            System.printf("  Supported targets: c, nasm, native, bytecode, hybrid\n");
            return 1;
        }

        // Write output file
        int writeOk = File.writeAll(outputFile, outputCode);
        if (!writeOk) {
            System.printf("Error: cannot write to file '%s'\n", outputFile);
            return 1;
        }

        System.printf("  Output written to: %s\n", outputFile);
        System.printf("Compilation complete!\n");
        return 0;
    }

    // 将原生模块转储为可读文本
    private static String dumpNativeModule(NativeModule module) {
        StringBuilder sb = new StringBuilder();
        sb.append("; Lemon Native Module (x86-64)\n");
        sb.append("; Generated by Lemon Compiler\n\n");

        // 外部函数
        sb.append("[Externs]\n");
        for (int i = 0; i < module.externNames.size(); i++) {
            String name = module.externNames.get(i);
            sb.append("  extern " + name + "\n");
        }
        sb.append("\n");

        // 数据段
        sb.append("[Data]\n");
        for (int di = 0; di < module.dataEntries.size(); di++) {
            NativeData data = module.dataEntries.get(di);
            sb.append("  " + data.name + ": ");
            for (int bi = 0; bi < data.bytes.size(); bi++) {
                if (bi > 0) sb.append(" ");
                int b = data.bytes.get(bi);
                String hex = "";
                if (b < 16) hex = "0";
                int hi = b / 16;
                int lo = b % 16;
                if (hi < 10) hex = hex + hi;
                else hex = hex + (char)(hi - 10 + 97);
                if (lo < 10) hex = hex + lo;
                else hex = hex + (char)(lo - 10 + 97);
                sb.append(hex);
            }
            sb.append("\n");
        }
        sb.append("\n");

        // 函数
        sb.append("[Functions]\n");
        for (int fi = 0; fi < module.functions.size(); fi++) {
            NativeFunction func = module.functions.get(fi);
            sb.append("  [" + func.name + "] params=" + func.paramCount + " size=" + func.code.size() + "\n");
            // 输出前 32 字节的十六进制
            int limit = func.code.size();
            if (limit > 64) limit = 64;
            sb.append("    ");
            for (int bi = 0; bi < limit; bi++) {
                if (bi > 0) sb.append(" ");
                int b = func.code.get(bi);
                int hi = b / 16;
                int lo = b % 16;
                if (hi < 10) sb.append(hi);
                else sb.append((char)(hi - 10 + 97));
                if (lo < 10) sb.append(lo);
                else sb.append((char)(lo - 10 + 97));
            }
            if (func.code.size() > 64) sb.append(" ...");
            sb.append("\n");
        }

        if (module.mainFuncName != null) {
            sb.append("\n[Main: " + module.mainFuncName + "]\n");
        }

        return sb.toString();
    }

    // 将字节数组写入二进制 .obj 文件
    private static void dumpObjFile(String path, Array<int> bytes) {
        // 将 int 数组转为字符串写入（每个 int 是一个字节 0-255）
        // 使用 Base64 编码或直接写二进制
        // Lemon 没有原生二进制写入，所以用十六进制文本格式
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < bytes.size(); i++) {
            int byteVal = bytes.get(i);
            int b = byteVal & 255;
            int hi = b / 16;
            int lo = b % 16;
            if (hi < 10) sb.append((char)(hi + 48));
            else sb.append((char)(hi - 10 + 97));
            if (lo < 10) sb.append((char)(lo + 48));
            else sb.append((char)(lo - 10 + 97));
        }
        int writeOk = File.writeAll(path, sb.toString());
        if (writeOk) {
            System.printf("  COFF64 object written to: %s (%d bytes)\n", path, bytes.size());
        } else {
            System.printf("  Warning: cannot write COFF64 object to: %s\n", path);
        }
    }

    // 将字节码模块转储为可读文本
    private static String dumpBytecodeModule(BytecodeModule module) {
        StringBuilder sb = new StringBuilder();
        sb.append("; Lemon Bytecode Module\n");
        sb.append("; Generated by Lemon Compiler\n\n");

        // 字符串常量池
        sb.append("[String Pool]\n");
        for (int i = 0; i < module.stringPool.size(); i++) {
            String entry = "  " + i + ": \"" + module.stringPool.get(i) + "\"\n";
            sb.append(entry);
        }
        sb.append("\n");

        // 类
        for (int ci = 0; ci < module.classes.size(); ci++) {
            BytecodeClass cls = module.classes.get(ci);
            sb.append("[Class: " + cls.name + "]\n");
            if (cls.parent != null) {
                sb.append("  extends: " + cls.parent + "\n");
            }
            sb.append("  instanceSize: " + cls.instanceSize + "\n");
            for (int fi = 0; fi < cls.fieldNames.size(); fi++) {
                String fLine = "  field " + fi + ": " + cls.fieldNames.get(fi) + " : " + cls.fieldTypes.get(fi) + "\n";
                sb.append(fLine);
            }
            sb.append("\n");

            for (int mi = 0; mi < cls.methods.size(); mi++) {
                BytecodeFunction func = cls.methods.get(mi);
                sb.append("  [Method: " + func.name + "]\n");
                String hdr = "    locals: " + func.localCount + ", params: " + func.paramCount + "\n";
                sb.append(hdr);
                for (int li = 0; li < func.localNames.size(); li++) {
                    String lLine = "    local " + li + ": " + func.localNames.get(li) + "\n";
                    sb.append(lLine);
                }
                for (int ii = 0; ii < func.instructions.size(); ii++) {
                    BytecodeInstruction inst = func.instructions.get(ii);
                    String iLine = "    " + ii + ": " + inst.toString() + "\n";
                    sb.append(iLine);
                }
                sb.append("\n");
            }
        }

        for (int fi = 0; fi < module.functions.size(); fi++) {
            BytecodeFunction func = module.functions.get(fi);
            sb.append("[Function: " + func.name + "]\n");
            String hdr = "  locals: " + func.localCount + ", params: " + func.paramCount + "\n";
            sb.append(hdr);
            for (int li = 0; li < func.localNames.size(); li++) {
                String lLine = "  local " + li + ": " + func.localNames.get(li) + "\n";
                sb.append(lLine);
            }
            for (int ii = 0; ii < func.instructions.size(); ii++) {
                BytecodeInstruction inst = func.instructions.get(ii);
                String iLine = "  " + ii + ": " + inst.toString() + "\n";
                sb.append(iLine);
            }
            sb.append("\n");
        }

        if (module.mainClass != null) {
            sb.append("[MainClass: " + module.mainClass + "]\n");
        }

        return sb.toString();
    }

    public static void main(String[] args) {
        // Parse command line arguments
        String outputFile = null;
        String target = "c";
        bool buildMode = false;
        Array<String> inputFiles = new Array<String>();

        for (int i = 0; i < args.length; i++) {
            String arg = args[i];
            if (arg.equals("-o") && i + 1 < args.length) {
                i = i + 1;
                outputFile = args[i];
            } else if (arg.equals("--target") && i + 1 < args.length) {
                i = i + 1;
                target = args[i];
            } else if (arg.equals("--build")) {
                buildMode = true;
            } else if (!arg.startsWith("-")) {
                inputFiles.add(arg);
            }
        }

        // --build mode: scan directory for .lm files
        if (buildMode) {
            String projectDir = ".";
            if (inputFiles.size() > 0) {
                projectDir = inputFiles.get(0);
            }

            System.printf("Scanning project directory: %s\n", projectDir);

            // Recursively find all .lm files
            Array<String> sourceFiles = new Array<String>();
            LemonCompiler.scanDir(projectDir, sourceFiles);

            if (sourceFiles.size() == 0) {
                System.printf("Error: no .lm files found in '%s'\n", projectDir);
                return;
            }

            // Sort files for deterministic compilation order
            // Simple bubble sort (sufficient for small file counts)
            for (int i = 0; i < sourceFiles.size() - 1; i++) {
                for (int j = i + 1; j < sourceFiles.size(); j++) {
                    String si = sourceFiles.get(i);
                    String sj = sourceFiles.get(j);
                    if (String.compareTo(si, sj) > 0) {
                        sourceFiles.set(i, sj);
                        sourceFiles.set(j, si);
                    }
                }
            }

            System.printf("Found %d source files:\n", sourceFiles.size());
            for (int i = 0; i < sourceFiles.size(); i++) {
                System.printf("  %s\n", sourceFiles.get(i));
            }

            // Default output: <dirname>.c
            if (outputFile == null) {
                // Extract directory name
                String dirName = projectDir;
                int lastSlash = dirName.lastIndexOf('/');
                if (lastSlash >= 0) dirName = dirName.substring(lastSlash + 1);
                int lastBackslash = dirName.lastIndexOf('\\');
                if (lastBackslash >= 0) dirName = dirName.substring(lastBackslash + 1);
                outputFile = dirName + ".c";
            }

            // Check target
            if (!target.equals("c") && !target.equals("nasm") && !target.equals("native") &&
                !target.equals("bytecode") && !target.equals("hybrid") && !target.equals("ir")) {
                System.printf("Warning: Unknown target '%s', using 'c'\n", target);
                target = "c";
            }

            LemonCompiler.compileFiles(sourceFiles, outputFile, target);
            return;
        }

        // Normal compilation mode
        if (inputFiles.size() == 0) {
            System.printf("Usage: lemonc <input.lm...> [-o output.c] [--target c] [--build [dir]]\n");
            System.printf("\nOptions:\n");
            System.printf("  -o <file>       Output file path\n");
            System.printf("  --target <tgt>  Compilation target (c, nasm, native, bytecode, hybrid)\n");
            System.printf("  --build [dir]   Build all .lm files in directory (default: current dir)\n");
            return;
        }

        // Check target
        if (!target.equals("c") && !target.equals("nasm") && !target.equals("native") &&
            !target.equals("bytecode") && !target.equals("hybrid")) {
            System.printf("Warning: Unknown target '%s', using 'c'\n", target);
            target = "c";
        }

        LemonCompiler.compileFiles(inputFiles, outputFile, target);
    }
}
