package lemon.ir;

// ============================================================
// IR 类型系统
// SSA IR 的类型定义，用于 IR 指令的操作数和结果类型
// ============================================================

// IR 类型种类
class IRTypeKind {
    public static int TYPE_VOID = 0;
    public static int BOOL = 1;
    public static int I8 = 2;
    public static int I16 = 3;
    public static int I32 = 4;
    public static int I64 = 5;
    public static int F32 = 6;
    public static int F64 = 7;
    public static int PTR = 8;
    public static int FUNC = 9;
    public static int STRUCT = 10;
    public static int ARRAY = 11;
}

// IR 类型
class IRType {
    public int kind;
    public String name;          // 结构体/函数类型名
    public int bitWidth;         // 整数/浮点位宽
    public IRType elementType;   // 数组/指针元素类型
    public int arraySize;        // 数组大小
    public Array<IRType> fieldTypes; // 结构体字段类型

    public IRType(int kind) {
        this.kind = kind;
        this.name = "";
        this.bitWidth = 0;
        this.elementType = null;
        this.arraySize = 0;
        this.fieldTypes = null;
    }

    public static IRType voidType() {
        return new IRType(IRTypeKind.TYPE_VOID);
    }

    public static IRType boolType() {
        IRType t = new IRType(IRTypeKind.BOOL);
        t.bitWidth = 1;
        return t;
    }

    public static IRType i8() {
        IRType t = new IRType(IRTypeKind.I8);
        t.bitWidth = 8;
        return t;
    }

    public static IRType i16() {
        IRType t = new IRType(IRTypeKind.I16);
        t.bitWidth = 16;
        return t;
    }

    public static IRType i32() {
        IRType t = new IRType(IRTypeKind.I32);
        t.bitWidth = 32;
        return t;
    }

    public static IRType i64() {
        IRType t = new IRType(IRTypeKind.I64);
        t.bitWidth = 64;
        return t;
    }

    public static IRType f32() {
        IRType t = new IRType(IRTypeKind.F32);
        t.bitWidth = 32;
        return t;
    }

    public static IRType f64() {
        IRType t = new IRType(IRTypeKind.F64);
        t.bitWidth = 64;
        return t;
    }

    public static IRType ptr(IRType elemType) {
        IRType t = new IRType(IRTypeKind.PTR);
        t.elementType = elemType;
        t.bitWidth = 64;
        return t;
    }

    public static IRType structType(String name, Array<IRType> fields) {
        IRType t = new IRType(IRTypeKind.STRUCT);
        t.name = name;
        t.fieldTypes = fields;
        return t;
    }

    public static IRType arrayType(IRType elemType, int size) {
        IRType t = new IRType(IRTypeKind.ARRAY);
        t.elementType = elemType;
        t.arraySize = size;
        return t;
    }

    public bool isInteger() {
        return this.kind >= IRTypeKind.I8 && this.kind <= IRTypeKind.I64;
    }

    public bool isFloat() {
        return this.kind == IRTypeKind.F32 || this.kind == IRTypeKind.F64;
    }

    public bool isPointer() {
        return this.kind == IRTypeKind.PTR;
    }

    public bool isVoid() {
        return this.kind == IRTypeKind.TYPE_VOID;
    }

    public int sizeInBytes() {
        if (this.kind == IRTypeKind.TYPE_VOID) return 0;
        if (this.kind == IRTypeKind.BOOL) return 1;
        if (this.kind == IRTypeKind.I8) return 1;
        if (this.kind == IRTypeKind.I16) return 2;
        if (this.kind == IRTypeKind.I32) return 4;
        if (this.kind == IRTypeKind.I64) return 8;
        if (this.kind == IRTypeKind.F32) return 4;
        if (this.kind == IRTypeKind.F64) return 8;
        if (this.kind == IRTypeKind.PTR) return 8;
        if (this.kind == IRTypeKind.STRUCT) {
            int size = 0;
            if (this.fieldTypes != null) {
                for (int i = 0; i < this.fieldTypes.size(); i++) {
                    IRType fieldType = this.fieldTypes.get(i);
                    size = size + fieldType.sizeInBytes();
                }
            }
            return size;
        }
        if (this.kind == IRTypeKind.ARRAY) {
            if (this.elementType != null) {
                return this.arraySize * this.elementType.sizeInBytes();
            }
            return 0;
        }
        return 0;
    }

    public String toString() {
        if (this.kind == IRTypeKind.TYPE_VOID) return "void";
        if (this.kind == IRTypeKind.BOOL) return "bool";
        if (this.kind == IRTypeKind.I8) return "i8";
        if (this.kind == IRTypeKind.I16) return "i16";
        if (this.kind == IRTypeKind.I32) return "i32";
        if (this.kind == IRTypeKind.I64) return "i64";
        if (this.kind == IRTypeKind.F32) return "f32";
        if (this.kind == IRTypeKind.F64) return "f64";
        if (this.kind == IRTypeKind.PTR) {
            if (this.elementType != null) return this.elementType.toString() + "*";
            return "ptr";
        }
        if (this.kind == IRTypeKind.STRUCT) return "%" + this.name;
        if (this.kind == IRTypeKind.ARRAY) {
            String elem = this.elementType != null ? this.elementType.toString() : "?";
            return "[" + this.arraySize + " x " + elem + "]";
        }
        return "?";
    }
}
