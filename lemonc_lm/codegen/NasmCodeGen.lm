package lemon.codegen;

import lemon.parser.AST;

// ============================================================
// NASM x86-64 汇编代码生成器
// 生成 Windows x64 调用约定的 NASM 语法汇编代码
// 运行时库通过链接 C 目标文件提供
//
// Windows x64 调用约定：
// - 整数参数: RCX, RDX, R8, R9
// - 浮点参数: XMM0-XMM3
// - 返回值: RAX (整数), XMM0 (浮点)
// - 被调用者保存: RBX, RBP, RSI, RDI, R12-R15
// - 栈对齐: 16 字节
// - 影子空间: 32 字节 (4 × 8)
// ============================================================

class NasmCodeGen {
    private StringBuilder output;
    private StringBuilder dataSection;
    private StringBuilder bssSection;
    private StringBuilder textSection;
    private int indent;
    private int stringCounter;
    private Array<String> stringLiterals;
    private Array<String> stringValues;
    private String currentClass;
    private String parentClass;
    private Map<String, String> varTypes;
    private Map<String, int> varStackOffsets;
    private int stackOffset;
    private Array<String> classNames;
    private Map<String, String> classFieldList;  // className.fieldName -> type
    private Map<String, int> classFieldOffsets;
    private Map<String, int> classSizes;
    private Map<String, Array<String> > methodSignatures;
    private int labelCounter;

    public NasmCodeGen() {
        this.output = new StringBuilder();
        this.dataSection = new StringBuilder();
        this.bssSection = new StringBuilder();
        this.textSection = new StringBuilder();
        this.indent = 0;
        this.stringCounter = 0;
        this.stringLiterals = new Array<String>();
        this.stringValues = new Array<String>();
        this.currentClass = null;
        this.parentClass = null;
        this.varTypes = new Map<String, String>();
        this.varStackOffsets = new Map<String, int>();
        this.stackOffset = 0;
        this.classNames = new Array<String>();
        this.classFieldList = new Map<String, String>();
        this.classFieldOffsets = new Map<String, int>();
        this.classSizes = new Map<String, int>();
        this.methodSignatures = new Map<String, Array<String> >();
        this.labelCounter = 0;
    }

    // ---- 主入口 ----

    public String generate(Program program) {
        // Phase 1: 收集信息
        this.collectClassInfo(program);
        this.collectMethodSignatures(program);

        // Phase 2: 生成汇编代码
        this.emitHeader();
        this.emitDataSection();
        this.emitBssSection();
        this.emitTextSection(program);
        this.emitMainEntry(program);

        // 组合所有段
        this.output.append(this.dataSection.toString());
        this.output.append(this.bssSection.toString());
        this.output.append(this.textSection.toString());

        return this.output.toString();
    }

    // ---- 信息收集 ----

    private void collectClassInfo(Program program) {
        for (int i = 0; i < program.declarations.size(); i++) {
            Declaration decl = program.declarations.get(i);
            if (decl.kind == DeclKind.Class) {
                ClassDecl class_ = decl.classDecl;
                this.classNames.add(class_.name);
                int offset = 0;
                for (int mi = 0; mi < class_.members.size(); mi++) {
                    ClassMember member = class_.members.get(mi);
                    if (member.kind == ClassMemberKind.Field) {
                        VarDecl field = member.field;
                        this.classFieldList.put(class_.name + "." + field.name, this.ct(field.varType));
                        this.classFieldOffsets.put(class_.name + "." + field.name, offset);
                        offset = offset + this.typeSize(field.varType);
                    }
                }
                this.classSizes.put(class_.name, offset);
            }
        }
    }

    private void collectMethodSignatures(Program program) {
        for (int i = 0; i < program.declarations.size(); i++) {
            Declaration decl = program.declarations.get(i);
            if (decl.kind == DeclKind.Class) {
                ClassDecl class_ = decl.classDecl;
                for (int mi = 0; mi < class_.members.size(); mi++) {
                    ClassMember member = class_.members.get(mi);
                    if (member.kind == ClassMemberKind.Method) {
                        String key = class_.name + "." + member.method.name;
                        if (!this.methodSignatures.containsKey(key)) {
                            this.methodSignatures.put(key, new Array<String>());
                        }
                        Array<String> sigs = this.methodSignatures.get(key);
                        sigs.add(member.method.name);
                    }
                }
            }
        }
    }

    // ---- 类型系统 ----

    private String ct(TypeRef typeRef) {
        if (typeRef == null) return "void*";
        if (typeRef.kind == TypeRefKind.Primitive) {
            if (typeRef.primitiveKind == PrimitiveType.Int) return "int32_t";
            if (typeRef.primitiveKind == PrimitiveType.Long) return "int64_t";
            if (typeRef.primitiveKind == PrimitiveType.Float) return "float";
            if (typeRef.primitiveKind == PrimitiveType.Double) return "double";
            if (typeRef.primitiveKind == PrimitiveType.Bool) return "int32_t";
            if (typeRef.primitiveKind == PrimitiveType.Char) return "char";
            if (typeRef.primitiveKind == PrimitiveType.Void) return "void";
            if (typeRef.primitiveKind == PrimitiveType.Byte) return "uint8_t";
            if (typeRef.primitiveKind == PrimitiveType.Short) return "int16_t";
            return "int32_t";
        }
        if (typeRef.kind == TypeRefKind.Array) return "LemonArray*";
        if (typeRef.kind == TypeRefKind.Named) {
            String name = typeRef.name;
            if (name.equals("String")) return "const char*";
            if (name.equals("Array")) return "LemonArray*";
            if (name.equals("Map") || name.equals("HashMap")) return "LemonMap*";
            if (name.equals("StringBuilder")) return "StringBuilder*";
            return name + "*";
        }
        return "void*";
    }

    private int typeSize(TypeRef typeRef) {
        if (typeRef == null) return 8;
        if (typeRef.kind == TypeRefKind.Primitive) {
            if (typeRef.primitiveKind == PrimitiveType.Int) return 4;
            if (typeRef.primitiveKind == PrimitiveType.Long) return 8;
            if (typeRef.primitiveKind == PrimitiveType.Float) return 4;
            if (typeRef.primitiveKind == PrimitiveType.Double) return 8;
            if (typeRef.primitiveKind == PrimitiveType.Bool) return 4;
            if (typeRef.primitiveKind == PrimitiveType.Char) return 1;
            if (typeRef.primitiveKind == PrimitiveType.Byte) return 1;
            if (typeRef.primitiveKind == PrimitiveType.Short) return 2;
            return 4;
        }
        return 8; // 指针大小
    }

    private bool isPointerType(TypeRef typeRef) {
        if (typeRef == null) return true;
        if (typeRef.kind == TypeRefKind.Array) return true;
        if (typeRef.kind == TypeRefKind.Named) {
            String name = typeRef.name;
            if (name.equals("String")) return true;
            if (name.equals("int") || name.equals("long") || name.equals("float") ||
                name.equals("double") || name.equals("bool") || name.equals("char") ||
                name.equals("byte") || name.equals("short") || name.equals("void")) return false;
            return true;
        }
        return false;
    }

    // ---- NASM 段生成 ----

    private void emitHeader() {
        this.dataSection.append("; Generated by Lemon Compiler (NASM x86-64)\n");
        this.dataSection.append("; Target: Windows x64\n\n");
    }

    private void emitDataSection() {
        this.dataSection.append("section .data\n");
        // 字符串字面量
        for (int i = 0; i < this.stringValues.size(); i++) {
            String name = this.stringLiterals.get(i);
            String value = this.stringValues.get(i);
            this.dataSection.append("    " + name + " db " + this.escapeForNasm(value) + ", 0\n");
        }
    }

    private void emitBssSection() {
        this.bssSection.append("\nsection .bss\n");
    }

    private void emitTextSection(Program program) {
        this.textSection.append("\nsection .text\n\n");
        // 外部函数声明
        this.emitExternDecls();
        // 全局入口
        this.textSection.append("global main\n\n");
        // 生成所有函数
        for (int i = 0; i < program.declarations.size(); i++) {
            Declaration decl = program.declarations.get(i);
            if (decl.kind == DeclKind.Class) {
                this.emitClass(decl.classDecl);
            } else if (decl.kind == DeclKind.Function) {
                this.emitFunction(decl.functionDecl);
            }
        }
    }

    private void emitExternDecls() {
        this.textSection.append("; ---- External C runtime functions ----\n");
        Array<String> externs = new Array<String>();
        externs.add("printf"); externs.add("malloc"); externs.add("free");
        externs.add("strlen"); externs.add("strcpy"); externs.add("strdup");
        externs.add("strcmp"); externs.add("strncmp"); externs.add("strstr");
        externs.add("strcat"); externs.add("memcpy"); externs.add("memset");
        externs.add("atoi"); externs.add("atol"); externs.add("atof");
        externs.add("sprintf"); externs.add("fprintf"); externs.add("exit");
        externs.add("String_length"); externs.add("String_indexOf");
        externs.add("String_substring"); externs.add("String_substring_from");
        externs.add("String_substring_from_to"); externs.add("String_trim");
        externs.add("String_toUpperCase"); externs.add("String_toLowerCase");
        externs.add("String_replace"); externs.add("String_concat");
        externs.add("String_equals"); externs.add("String_startsWith");
        externs.add("String_endsWith"); externs.add("String_contains");
        externs.add("String_compareTo"); externs.add("String_lastIndexOf");
        externs.add("String_fromChar"); externs.add("String_intToString");
        externs.add("String_longToString"); externs.add("String_doubleToString");
        externs.add("String_toInt"); externs.add("String_toLong");
        externs.add("String_toDouble");
        externs.add("StringBuilder_new"); externs.add("StringBuilder_append");
        externs.add("StringBuilder_appendChar"); externs.add("StringBuilder_appendInt");
        externs.add("StringBuilder_appendLong"); externs.add("StringBuilder_appendFloat");
        externs.add("StringBuilder_appendDouble"); externs.add("StringBuilder_appendBool");
        externs.add("StringBuilder_toString"); externs.add("StringBuilder_length");
        externs.add("StringBuilder_free"); externs.add("StringBuilder_clear");
        externs.add("LemonArray_new"); externs.add("LemonArray_add");
        externs.add("LemonArray_push"); externs.add("LemonArray_get");
        externs.add("LemonArray_set"); externs.add("LemonArray_size");
        externs.add("LemonArray_removeAt"); externs.add("LemonArray_contains");
        externs.add("LemonArray_indexOf"); externs.add("LemonArray_free");
        externs.add("LemonMap_new"); externs.add("LemonMap_put");
        externs.add("LemonMap_get"); externs.add("LemonMap_containsKey");
        externs.add("LemonMap_remove"); externs.add("LemonMap_size");
        externs.add("LemonMap_free");
        externs.add("File_readAll"); externs.add("File_writeAll");
        externs.add("File_exists"); externs.add("File_delete");
        externs.add("File_listDir"); externs.add("File_isDir");
        for (int i = 0; i < externs.size(); i++) {
            this.textSection.append("extern " + externs.get(i) + "\n");
        }
        this.textSection.append("\n");
    }

    // ---- 类生成 ----

    private void emitClass(ClassDecl class_) {
        this.currentClass = class_.name;
        this.parentClass = null;
        if (class_.extends_ != null && class_.extends_.kind == TypeRefKind.Named) {
            this.parentClass = class_.extends_.name;
        }

        // 构造函数
        for (int mi = 0; mi < class_.members.size(); mi++) {
            ClassMember member = class_.members.get(mi);
            if (member.kind == ClassMemberKind.Constructor) {
                this.emitConstructor(class_.name, member.constructor);
            }
        }

        // 方法
        for (int mi = 0; mi < class_.members.size(); mi++) {
            ClassMember member = class_.members.get(mi);
            if (member.kind == ClassMemberKind.Method) {
                this.emitMethod(class_.name, member.method);
            }
        }

        // 析构函数
        for (int mi = 0; mi < class_.members.size(); mi++) {
            ClassMember member = class_.members.get(mi);
            if (member.kind == ClassMemberKind.Destructor) {
                this.emitDestructor(class_.name, member.destructor);
            }
        }

        this.currentClass = null;
        this.parentClass = null;
    }

    // ---- 函数/方法生成 ----

    private void emitConstructor(String className, ConstructorDecl ctor) {
        String funcName = className + "_ctor";
        this.textSection.append("; ---- Constructor: " + funcName + " ----\n");
        this.textSection.append(funcName + ":\n");

        // 函数序言
        this.emitPrologue();

        // 分配 self
        int classSize = 0;
        if (this.classSizes.containsKey(className)) {
            classSize = this.classSizes.get(className);
        }
        if (classSize == 0) classSize = 8; // 最少一个指针

        this.emitLine("    ; Allocate " + className + " instance (" + classSize + " bytes)");
        this.emitLine("    mov rcx, " + classSize);
        this.emitCall("malloc");
        this.emitLine("    mov [rbp-8], rax  ; self");

        // 初始化字段为零
        this.emitLine("    mov rcx, [rbp-8]");
        this.emitLine("    mov rdx, 0");
        if (classSize <= 4) {
            this.emitLine("    mov dword [rcx], edx");
        } else {
            this.emitLine("    mov r8, " + classSize);
            this.emitCall("memset");
        }

        // 生成构造函数体
        this.varStackOffsets = new Map<String, int>();
        this.varStackOffsets.put("self", -8);
        this.stackOffset = -16;
        this.emitBlock(ctor.body);

        // 返回 self
        this.emitLine("    mov rax, [rbp-8]  ; return self");
        this.emitEpilogue();
        this.textSection.append("\n");
    }

    private void emitMethod(String className, MethodDecl method) {
        String funcName = className + "_" + method.name;
        this.textSection.append("; ---- Method: " + funcName + " ----\n");
        this.textSection.append(funcName + ":\n");

        this.emitPrologue();

        // 设置参数映射
        this.varStackOffsets = new Map<String, int>();
        this.varStackOffsets.put("self", -8);
        this.stackOffset = -16;

        // 方法参数: self(RCX), arg1(RDX), arg2(R8), arg3(R9), 其余在栈上
        if (method.params != null) {
            for (int pi = 0; pi < method.params.size(); pi++) {
                Param param = method.params.get(pi);
                this.varStackOffsets.put(param.name, this.stackOffset);
                // 保存参数到栈
                this.emitStoreArg(pi, this.stackOffset);
                this.stackOffset = this.stackOffset - 8;
            }
        }

        // 生成方法体
        if (method.body != null) {
            this.emitBlock(method.body);
        }

        this.emitEpilogue();
        this.textSection.append("\n");
    }

    private void emitDestructor(String className, DestructorDecl dtor) {
        String funcName = className + "_dtor";
        this.textSection.append("; ---- Destructor: " + funcName + " ----\n");
        this.textSection.append(funcName + ":\n");
        this.emitPrologue();
        this.varStackOffsets = new Map<String, int>();
        this.varStackOffsets.put("self", -8);
        this.stackOffset = -16;
        if (dtor.body != null) {
            this.emitBlock(dtor.body);
        }
        this.emitEpilogue();
        this.textSection.append("\n");
    }

    private void emitFunction(FunctionDecl func) {
        String funcName = func.name;
        this.textSection.append("; ---- Function: " + funcName + " ----\n");
        this.textSection.append(funcName + ":\n");

        this.emitPrologue();

        this.varStackOffsets = new Map<String, int>();
        this.stackOffset = -8;

        // 函数参数: arg1(RCX), arg2(RDX), arg3(R8), arg4(R9)
        if (func.params != null) {
            for (int pi = 0; pi < func.params.size(); pi++) {
                Param param = func.params.get(pi);
                this.varStackOffsets.put(param.name, this.stackOffset);
                this.emitStoreArg(pi, this.stackOffset);
                this.stackOffset = this.stackOffset - 8;
            }
        }

        if (func.body != null) {
            this.emitBlock(func.body);
        }

        this.emitEpilogue();
        this.textSection.append("\n");
    }

    // ---- 函数序言/尾声 ----

    private void emitPrologue() {
        this.emitLine("    push rbp");
        this.emitLine("    mov rbp, rsp");
        // 分配栈空间（最大 256 字节局部变量）
        this.emitLine("    sub rsp, 256");
        // 保存被调用者保存寄存器
        this.emitLine("    push rbx");
        this.emitLine("    push rsi");
        this.emitLine("    push rdi");
    }

    private void emitEpilogue() {
        // 恢复被调用者保存寄存器
        this.emitLine("    pop rdi");
        this.emitLine("    pop rsi");
        this.emitLine("    pop rbx");
        this.emitLine("    mov rsp, rbp");
        this.emitLine("    pop rbp");
        this.emitLine("    ret");
    }

    // ---- 参数保存 ----

    private void emitStoreArg(int argIndex, int stackOff) {
        String off = "" + stackOff;
        if (argIndex == 0) this.emitLine("    mov [rbp" + off + "], rcx");
        else if (argIndex == 1) this.emitLine("    mov [rbp" + off + "], rdx");
        else if (argIndex == 2) this.emitLine("    mov [rbp" + off + "], r8");
        else if (argIndex == 3) this.emitLine("    mov [rbp" + off + "], r9");
        else {
            // 从调用者的影子空间之后的栈上取参数
            int stackArgOff = 16 + (argIndex - 4) * 8;
            this.emitLine("    mov rax, [rbp+" + stackArgOff + "]");
            this.emitLine("    mov [rbp" + off + "], rax");
        }
    }

    // ---- 语句生成 ----

    private void emitBlock(Block block) {
        if (block == null || block.statements == null) return;
        for (int i = 0; i < block.statements.size(); i++) {
            this.emitStmt(block.statements.get(i));
        }
    }

    private void emitStmt(Stmt stmt) {
        if (stmt.kind == StmtKind.VarDecl) {
            this.emitVarDecl(stmt.varDecl);
        } else if (stmt.kind == StmtKind.Return) {
            this.emitReturn(stmt.returnValue);
        } else if (stmt.kind == StmtKind.Expr) {
            this.emitExprStmt(stmt.expr);
        } else if (stmt.kind == StmtKind.If) {
            this.emitIf(stmt);
        } else if (stmt.kind == StmtKind.While) {
            this.emitWhile(stmt);
        } else if (stmt.kind == StmtKind.Block) {
            this.emitBlock(new Block(stmt.statements));
        } else if (stmt.kind == StmtKind.Break) {
            this.emitLine("    jmp .loop_end_" + this.labelCounter);
        } else if (stmt.kind == StmtKind.Continue) {
            this.emitLine("    jmp .loop_start_" + this.labelCounter);
        }
    }

    private void emitVarDecl(VarDecl varDecl) {
        int off = this.stackOffset;
        this.varStackOffsets.put(varDecl.name, off);
        this.stackOffset = this.stackOffset - 8;
        if (varDecl.initializer != null) {
            this.emitExprToReg(varDecl.initializer, "rax");
            this.emitLine("    mov [rbp" + off + "], rax");
        }
    }

    private void emitReturn(Expr returnValue) {
        if (returnValue != null) {
            this.emitExprToReg(returnValue, "rax");
        }
        this.emitEpilogue();
    }

    private void emitExprStmt(Expr expr) {
        this.emitExprToReg(expr, "rax");
    }

    private void emitIf(Stmt stmt) {
        int label = this.freshLabel();
        this.emitExprToReg(stmt.condition, "rax");
        this.emitLine("    test rax, rax");
        this.emitLine("    jz .else_" + label);
        this.emitStmt(stmt.thenBranch);
        this.emitLine("    jmp .endif_" + label);
        this.textSection.append(".else_" + label + ":\n");
        if (stmt.elseBranch != null) {
            this.emitStmt(stmt.elseBranch);
        }
        this.textSection.append(".endif_" + label + ":\n");
    }

    private void emitWhile(Stmt stmt) {
        int label = this.freshLabel();
        int savedLabel = this.labelCounter;
        this.labelCounter = label;
        this.textSection.append(".loop_start_" + label + ":\n");
        this.emitExprToReg(stmt.condition, "rax");
        this.emitLine("    test rax, rax");
        this.emitLine("    jz .loop_end_" + label);
        this.emitStmt(stmt.body);
        this.emitLine("    jmp .loop_start_" + label);
        this.textSection.append(".loop_end_" + label + ":\n");
        this.labelCounter = savedLabel;
    }

    // ---- 表达式生成 ----

    // 将表达式结果放入指定寄存器
    private void emitExprToReg(Expr expr, String reg) {
        if (expr.kind == ExprKind.IntegerLiteral) {
            this.emitLine("    mov " + reg + ", " + expr.longValue);
        } else if (expr.kind == ExprKind.FloatLiteral) {
            // 浮点数通过字符串字面量加载
            String strName = this.freshStringLiteral("" + expr.doubleValue);
            this.emitLine("    mov rcx, " + strName);
            this.emitCall("atof");
            // 结果在 xmm0 中，移动到 rax
            this.emitLine("    movq " + reg + ", xmm0");
        } else if (expr.kind == ExprKind.BoolLiteral) {
            if (expr.boolValue) {
                this.emitLine("    mov " + reg + ", 1");
            } else {
                this.emitLine("    mov " + reg + ", 0");
            }
        } else if (expr.kind == ExprKind.Null) {
            this.emitLine("    mov " + reg + ", 0");
        } else if (expr.kind == ExprKind.StringLiteral) {
            String strName = this.freshStringLiteral(expr.strValue);
            this.emitLine("    lea " + reg + ", [" + strName + "]");
        } else if (expr.kind == ExprKind.CharLiteral) {
            this.emitLine("    mov " + reg + ", " + ((int)expr.charValue));
        } else if (expr.kind == ExprKind.Variable) {
            int off = 0;
            if (this.varStackOffsets.containsKey(expr.strValue)) {
                off = this.varStackOffsets.get(expr.strValue);
            }
            this.emitLine("    mov " + reg + ", [rbp" + off + "]  ; " + expr.strValue);
        } else if (expr.kind == ExprKind.This) {
            this.emitLine("    mov " + reg + ", [rbp-8]  ; this/self");
        } else if (expr.kind == ExprKind.BinaryOp) {
            this.emitBinaryOp(expr, reg);
        } else if (expr.kind == ExprKind.UnaryOp) {
            this.emitUnaryOp(expr, reg);
        } else if (expr.kind == ExprKind.Assignment) {
            this.emitAssignment(expr, reg);
        } else if (expr.kind == ExprKind.Call) {
            this.emitCallExpr(expr, reg);
        } else if (expr.kind == ExprKind.MethodCall) {
            this.emitMethodCallExpr(expr, reg);
        } else if (expr.kind == ExprKind.FieldAccess) {
            this.emitFieldAccess(expr, reg);
        } else if (expr.kind == ExprKind.New) {
            this.emitNewExpr(expr, reg);
        } else if (expr.kind == ExprKind.ArrayAccess) {
            this.emitArrayAccess(expr, reg);
        } else if (expr.kind == ExprKind.Cast) {
            this.emitExprToReg(expr.operand, reg);
        } else if (expr.kind == ExprKind.Ternary) {
            this.emitTernary(expr, reg);
        } else {
            this.emitLine("    mov " + reg + ", 0  ; unsupported expr kind " + expr.kind);
        }
    }

    private void emitBinaryOp(Expr expr, String reg) {
        this.emitExprToReg(expr.left, "rax");
        this.emitLine("    push rax");
        this.emitExprToReg(expr.right, "rcx");
        this.emitLine("    pop rax");

        int op = expr.opValue;
        if (op == BinaryOp.Add) {
            this.emitLine("    add rax, rcx");
        } else if (op == BinaryOp.Sub) {
            this.emitLine("    sub rax, rcx");
        } else if (op == BinaryOp.Mul) {
            this.emitLine("    imul rax, rcx");
        } else if (op == BinaryOp.Div) {
            this.emitLine("    cqo");
            this.emitLine("    idiv rcx");
        } else if (op == BinaryOp.Mod) {
            this.emitLine("    cqo");
            this.emitLine("    idiv rcx");
            this.emitLine("    mov rax, rdx");
        } else if (op == BinaryOp.Eq) {
            this.emitLine("    cmp rax, rcx");
            this.emitLine("    sete al");
            this.emitLine("    movzx rax, al");
        } else if (op == BinaryOp.Ne) {
            this.emitLine("    cmp rax, rcx");
            this.emitLine("    setne al");
            this.emitLine("    movzx rax, al");
        } else if (op == BinaryOp.Lt) {
            this.emitLine("    cmp rax, rcx");
            this.emitLine("    setl al");
            this.emitLine("    movzx rax, al");
        } else if (op == BinaryOp.Gt) {
            this.emitLine("    cmp rax, rcx");
            this.emitLine("    setg al");
            this.emitLine("    movzx rax, al");
        } else if (op == BinaryOp.Le) {
            this.emitLine("    cmp rax, rcx");
            this.emitLine("    setle al");
            this.emitLine("    movzx rax, al");
        } else if (op == BinaryOp.Ge) {
            this.emitLine("    cmp rax, rcx");
            this.emitLine("    setge al");
            this.emitLine("    movzx rax, al");
        } else if (op == BinaryOp.And) {
            this.emitLine("    and rax, rcx");
        } else if (op == BinaryOp.Or) {
            this.emitLine("    or rax, rcx");
        } else if (op == BinaryOp.BitAnd) {
            this.emitLine("    and rax, rcx");
        } else if (op == BinaryOp.BitOr) {
            this.emitLine("    or rax, rcx");
        } else if (op == BinaryOp.BitXor) {
            this.emitLine("    xor rax, rcx");
        } else if (op == BinaryOp.Shl) {
            this.emitLine("    mov rcx, rcx");
            this.emitLine("    shl rax, cl");
        } else if (op == BinaryOp.Shr) {
            this.emitLine("    sar rax, cl");
        }
    }

    private void emitUnaryOp(Expr expr, String reg) {
        this.emitExprToReg(expr.operand, reg);
        int op = expr.opValue;
        if (op == UnaryOp.Minus) {
            this.emitLine("    neg " + reg);
        } else if (op == UnaryOp.Not) {
            this.emitLine("    xor " + reg + ", 1");
        } else if (op == UnaryOp.BitNot) {
            this.emitLine("    not " + reg);
        }
    }

    private void emitAssignment(Expr expr, String reg) {
        this.emitExprToReg(expr.value, "rax");
        if (expr.target.kind == ExprKind.Variable) {
            int off = 0;
            if (this.varStackOffsets.containsKey(expr.target.strValue)) {
                off = this.varStackOffsets.get(expr.target.strValue);
            }
            this.emitLine("    mov [rbp" + off + "], rax  ; assign " + expr.target.strValue);
        } else if (expr.target.kind == ExprKind.FieldAccess) {
            // obj.field = value
            this.emitExprToReg(expr.target.receiver, "rcx");
            int fieldOff = 0;
            if (this.currentClass != null) {
                String key = this.currentClass + "." + expr.target.strValue;
                if (this.classFieldOffsets.containsKey(key)) {
                    fieldOff = this.classFieldOffsets.get(key);
                }
            }
            this.emitLine("    mov [rcx+" + fieldOff + "], rax  ; assign field " + expr.target.strValue);
        }
        this.emitLine("    mov " + reg + ", rax");
    }

    private void emitCallExpr(Expr expr, String reg) {
        if (expr.callee.kind == ExprKind.Variable) {
            String funcName = expr.callee.strValue;
            // 准备参数
            this.emitPrepareArgs(expr.args);
            this.emitCall(funcName);
            this.emitLine("    mov " + reg + ", rax");
        } else if (expr.callee.kind == ExprKind.FieldAccess) {
            // obj.method(args)
            Expr obj = expr.callee.receiver;
            String method = expr.callee.strValue;
            this.emitObjMethodCall(obj, method, expr.args, reg);
        }
    }

    private void emitMethodCallExpr(Expr expr, String reg) {
        this.emitObjMethodCall(expr.receiver, expr.strValue, expr.args, reg);
    }

    private void emitObjMethodCall(Expr obj, String method, Array<Expr> args, String reg) {
        // 特殊处理内置类型方法
        if (obj.kind == ExprKind.Variable) {
            String varName = obj.strValue;
            // String 静态方法
            if (varName.equals("String")) {
                this.emitBuiltinStaticCall("String", method, args, reg);
                return;
            }
            if (varName.equals("System")) {
                this.emitBuiltinStaticCall("System", method, args, reg);
                return;
            }
            if (varName.equals("Array")) {
                this.emitBuiltinStaticCall("Array", method, args, reg);
                return;
            }
            if (varName.equals("File")) {
                this.emitBuiltinStaticCall("File", method, args, reg);
                return;
            }
        }

        // 实例方法调用: 先加载对象到 RCX（第一个参数=self）
        this.emitExprToReg(obj, "rcx");
        this.emitLine("    push rcx  ; save self");

        // 准备其余参数
        for (int i = 0; i < args.size(); i++) {
            this.emitExprToReg(args.get(i), "rax");
            if (i == 0) this.emitLine("    mov rdx, rax");
            else if (i == 1) this.emitLine("    mov r8, rax");
            else if (i == 2) this.emitLine("    mov r9, rax");
            else {
                this.emitLine("    push rax");
            }
        }

        this.emitLine("    pop rcx  ; restore self");

        // 确定函数名
        String objClass = this.inferClassFromExpr(obj);
        String funcName = null;
        if (objClass != null) {
            // 内置类型方法
            if (objClass.equals("String")) {
                funcName = "String_" + method;
            } else if (objClass.equals("StringBuilder")) {
                funcName = "StringBuilder_" + method;
            } else if (objClass.equals("LemonArray")) {
                funcName = "LemonArray_" + method;
            } else if (objClass.equals("LemonMap")) {
                funcName = "LemonMap_" + method;
            } else {
                funcName = objClass + "_" + method;
            }
        } else if (this.currentClass != null) {
            funcName = this.currentClass + "_" + method;
        }

        if (funcName != null) {
            this.emitCall(funcName);
            this.emitLine("    mov " + reg + ", rax");
        } else {
            this.emitLine("    ; unknown method call: " + method);
            this.emitLine("    mov " + reg + ", 0");
        }
    }

    private void emitBuiltinStaticCall(String typeName, String method, Array<Expr> args, String reg) {
        this.emitPrepareArgs(args);
        String funcName = typeName + "_" + method;
        this.emitCall(funcName);
        this.emitLine("    mov " + reg + ", rax");
    }

    private void emitPrepareArgs(Array<Expr> args) {
        for (int i = 0; i < args.size(); i++) {
            this.emitExprToReg(args.get(i), "rax");
            if (i == 0) this.emitLine("    mov rcx, rax");
            else if (i == 1) this.emitLine("    mov rdx, rax");
            else if (i == 2) this.emitLine("    mov r8, rax");
            else if (i == 3) this.emitLine("    mov r9, rax");
            else this.emitLine("    push rax  ; arg " + i);
        }
    }

    private void emitFieldAccess(Expr expr, String reg) {
        this.emitExprToReg(expr.receiver, "rax");
        // 计算字段偏移
        int fieldOff = 0;
        if (this.currentClass != null) {
            String key = this.currentClass + "." + expr.strValue;
            if (this.classFieldOffsets.containsKey(key)) {
                fieldOff = this.classFieldOffsets.get(key);
            }
        }
        if (fieldOff == 0) {
            this.emitLine("    mov " + reg + ", [rax]  ; field " + expr.strValue);
        } else {
            this.emitLine("    mov " + reg + ", [rax+" + fieldOff + "]  ; field " + expr.strValue);
        }
    }

    private void emitNewExpr(Expr expr, String reg) {
        String className = expr.strValue;
        // 调用 ClassName_ctor(NULL, args...)
        this.emitLine("    mov rcx, 0  ; no self yet");
        for (int i = 0; i < expr.args.size(); i++) {
            this.emitExprToReg(expr.args.get(i), "rax");
            if (i == 0) this.emitLine("    mov rdx, rax");
            else if (i == 1) this.emitLine("    mov r8, rax");
            else if (i == 2) this.emitLine("    mov r9, rax");
        }
        this.emitCall(className + "_ctor");
        this.emitLine("    mov " + reg + ", rax");
    }

    private void emitArrayAccess(Expr expr, String reg) {
        this.emitExprToReg(expr.receiver, "rcx");
        this.emitExprToReg(expr.index, "rdx");
        this.emitCall("LemonArray_get");
        this.emitLine("    mov " + reg + ", rax");
    }

    private void emitTernary(Expr expr, String reg) {
        int label = this.freshLabel();
        this.emitExprToReg(expr.condition, "rax");
        this.emitLine("    test rax, rax");
        this.emitLine("    jz .ternary_else_" + label);
        this.emitExprToReg(expr.thenExpr, reg);
        this.emitLine("    jmp .ternary_end_" + label);
        this.textSection.append(".ternary_else_" + label + ":\n");
        this.emitExprToReg(expr.elseExpr, reg);
        this.textSection.append(".ternary_end_" + label + ":\n");
    }

    // ---- 函数调用（Windows x64 调用约定） ----

    private void emitCall(String funcName) {
        // 分配影子空间 + 栈对齐
        this.emitLine("    sub rsp, 40  ; shadow space (32) + alignment (8)");
        this.emitLine("    call " + funcName);
        this.emitLine("    add rsp, 40");
    }

    // ---- Main 入口 ----

    private void emitMainEntry(Program program) {
        this.textSection.append("; ---- Main entry point ----\n");
        this.textSection.append("main:\n");
        this.emitPrologue();

        // 查找包含 main 方法的类
        String mainClass = null;
        for (int i = 0; i < program.declarations.size(); i++) {
            Declaration decl = program.declarations.get(i);
            if (decl.kind == DeclKind.Class) {
                ClassDecl class_ = decl.classDecl;
                for (int mi = 0; mi < class_.members.size(); mi++) {
                    ClassMember member = class_.members.get(mi);
                    if (member.kind == ClassMemberKind.Method && member.method.name.equals("main")) {
                        mainClass = class_.name;
                    }
                }
            }
        }

        if (mainClass != null) {
            // 构建 args 数组
            this.emitLine("    ; Save argc and argv");
            this.emitLine("    mov [rbp-8], rcx  ; argc");
            this.emitLine("    mov [rbp-16], rdx  ; argv");

            // 创建 LemonArray
            this.emitLine("    mov rcx, [rbp-8]  ; size = argc");
            this.emitCall("LemonArray_new");
            this.emitLine("    mov [rbp-24], rax  ; args array");

            // 填充 args 数组
            int loopLabel = this.freshLabel();
            this.textSection.append(".args_loop_" + loopLabel + ":\n");
            this.emitLine("    mov rcx, [rbp-8]  ; argc");
            this.emitLine("    cmp dword [rbp-32], 0");
            this.emitLine("    jge .args_end_" + loopLabel);

            // TODO: 完整的 args 填充

            this.textSection.append(".args_end_" + loopLabel + ":\n");

            // 调用 ClassName_main(NULL, args)
            this.emitLine("    mov rcx, 0  ; self = NULL");
            this.emitLine("    mov rdx, [rbp-24]  ; args");
            this.emitCall(mainClass + "_main");
        }

        // 返回 0
        this.emitLine("    mov rax, 0");
        this.emitEpilogue();
    }

    // ---- 辅助方法 ----

    private String freshStringLiteral(String value) {
        String name = "_nstr_" + this.stringCounter;
        this.stringCounter = this.stringCounter + 1;
        this.stringLiterals.add(name);
        this.stringValues.add(value);
        return name;
    }

    private int freshLabel() {
        this.labelCounter = this.labelCounter + 1;
        return this.labelCounter;
    }

    private void emitLine(String s) {
        this.textSection.append(s + "\n");
    }

    private String inferClassFromExpr(Expr expr) {
        if (expr == null) return null;
        if (expr.kind == ExprKind.Variable) {
            String varName = expr.strValue;
            if (this.varTypes.containsKey(varName)) {
                String t = this.varTypes.get(varName);
                if (t.equals("const char*") || t.equals("char*")) return "String";
                if (t.equals("LemonArray*")) return "LemonArray";
                if (t.equals("LemonMap*")) return "LemonMap";
                if (t.equals("StringBuilder*")) return "StringBuilder";
                if (t.endsWith("*")) return t.substring(0, t.length() - 1);
            }
        }
        return null;
    }

    private String escapeForNasm(String s) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '"') sb.append("\\\"");
            else if (c == '\\') sb.append("\\\\");
            else if (c == '\n') sb.append("\\n");
            else if (c == '\t') sb.append("\\t");
            else if (c == '\r') sb.append("\\r");
            else if (c == 0) sb.append("\\0");
            else sb.appendChar(c);
        }
        return sb.toString();
    }
}
