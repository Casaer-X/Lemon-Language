package lemon.jit;

import lemon.parser.AST;

// ============================================================
// 字节码编译器
// 将 AST 编译为 BytecodeModule
// 基于栈的字节码生成
// ============================================================

class BytecodeCompiler {
    private BytecodeModule module;
    private BytecodeFunction currentFunc;
    private String currentClass;
    private Map<String, int> localIndexMap;
    private int nextLocalIndex;
    private int labelCounter;
    private Map<String, int> labelPositions;  // label ID -> instruction index

    public BytecodeCompiler() {
        this.module = new BytecodeModule();
        this.currentFunc = null;
        this.currentClass = null;
        this.localIndexMap = new Map<String, int>();
        this.nextLocalIndex = 0;
        this.labelCounter = 0;
        this.labelPositions = new Map<String, int>();
    }

    // ---- 主入口 ----

    public BytecodeModule compile(Program program) {
        // 第一遍：收集类和函数声明
        for (int i = 0; i < program.declarations.size(); i++) {
            Declaration decl = program.declarations.get(i);
            if (decl.kind == DeclKind.Class) {
                this.declareClass(decl.classDecl);
            } else if (decl.kind == DeclKind.Function) {
                this.declareFunction(decl.functionDecl);
            }
        }

        // 第二遍：编译方法/函数体
        for (int i = 0; i < program.declarations.size(); i++) {
            Declaration decl = program.declarations.get(i);
            if (decl.kind == DeclKind.Class) {
                this.compileClass(decl.classDecl);
            } else if (decl.kind == DeclKind.Function) {
                this.compileFunction(decl.functionDecl);
            }
        }

        return this.module;
    }

    // ---- 声明收集 ----

    private void declareClass(ClassDecl class_) {
        BytecodeClass bcClass = new BytecodeClass(class_.name);
        if (class_.extends_ != null && class_.extends_.kind == TypeRefKind.Named) {
            bcClass.parent = class_.extends_.name;
        }
        // 收集字段
        for (int mi = 0; mi < class_.members.size(); mi++) {
            ClassMember member = class_.members.get(mi);
            if (member.kind == ClassMemberKind.Field) {
                VarDecl field = member.field;
                int size = this.typeSize(field.varType);
                bcClass.addField(field.name, this.typeName(field.varType), size);
            }
        }
        // 声明方法
        for (int mi = 0; mi < class_.members.size(); mi++) {
            ClassMember member = class_.members.get(mi);
            if (member.kind == ClassMemberKind.Method) {
                String mthdName = member.method.name;
                String methodName = class_.name + "_" + mthdName;
                BytecodeFunction bcFunc = new BytecodeFunction(methodName);
                bcFunc.className = class_.name;
                bcClass.methods.add(bcFunc);
                // 检查是否为 main 方法
                if (mthdName.equals("main")) {
                    this.module.mainClass = class_.name;
                }
            }
        }
        this.module.classes.add(bcClass);
    }

    private void declareFunction(FunctionDecl func) {
        BytecodeFunction bcFunc = new BytecodeFunction(func.name);
        this.module.functions.add(bcFunc);
    }

    // ---- 类编译 ----

    private void compileClass(ClassDecl class_) {
        this.currentClass = class_.name;
        for (int mi = 0; mi < class_.members.size(); mi++) {
            ClassMember member = class_.members.get(mi);
            if (member.kind == ClassMemberKind.Method) {
                String methodName = class_.name + "_" + member.method.name;
                BytecodeFunction bcFunc = this.findMethod(methodName);
                if (bcFunc != null) {
                    this.currentFunc = bcFunc;
                    this.setupLocals(member.method);
                    this.compileBlock(member.method.body);
                    this.currentFunc.emit(OpCode.RET_VOID);
                    this.resolveLabels();
                    this.currentFunc = null;
                }
            }
        }
        this.currentClass = null;
    }

    private void compileFunction(FunctionDecl func) {
        BytecodeFunction bcFunc = this.findFunction(func.name);
        if (bcFunc != null) {
            this.currentFunc = bcFunc;
            this.setupLocalsForFunction(func);
            this.compileBlock(func.body);
            this.currentFunc.emit(OpCode.RET_VOID);
            this.resolveLabels();
            this.currentFunc = null;
        }
    }

    // ---- 局部变量设置 ----

    private void setupLocals(MethodDecl method) {
        this.localIndexMap = new Map<String, int>();
        this.nextLocalIndex = 0;
        // self/this
        this.localIndexMap.put("self", this.nextLocalIndex);
        this.currentFunc.addLocal("self");
        this.nextLocalIndex = this.nextLocalIndex + 1;
        // 参数
        if (method.params != null) {
            for (int i = 0; i < method.params.size(); i++) {
                Param param = method.params.get(i);
                this.localIndexMap.put(param.name, this.nextLocalIndex);
                this.currentFunc.addLocal(param.name);
                this.nextLocalIndex = this.nextLocalIndex + 1;
            }
        }
    }

    private void setupLocalsForFunction(FunctionDecl func) {
        this.localIndexMap = new Map<String, int>();
        this.nextLocalIndex = 0;
        if (func.params != null) {
            for (int i = 0; i < func.params.size(); i++) {
                Param param = func.params.get(i);
                this.localIndexMap.put(param.name, this.nextLocalIndex);
                this.currentFunc.addLocal(param.name);
                this.nextLocalIndex = this.nextLocalIndex + 1;
            }
        }
    }

    // ---- 块编译 ----

    private void compileBlock(Block block) {
        if (block == null || block.statements == null) return;
        for (int i = 0; i < block.statements.size(); i++) {
            this.compileStmt(block.statements.get(i));
        }
    }

    // ---- 语句编译 ----

    private void compileStmt(Stmt stmt) {
        if (stmt.kind == StmtKind.VarDecl) {
            this.compileVarDecl(stmt.varDecl);
        } else if (stmt.kind == StmtKind.Return) {
            this.compileReturn(stmt.returnValue);
        } else if (stmt.kind == StmtKind.Expr) {
            this.compileExpr(stmt.expr);
            this.currentFunc.emit(OpCode.POP);
        } else if (stmt.kind == StmtKind.If) {
            this.compileIf(stmt);
        } else if (stmt.kind == StmtKind.While) {
            this.compileWhile(stmt);
        } else if (stmt.kind == StmtKind.Block) {
            this.compileBlock(new Block(stmt.statements));
        } else if (stmt.kind == StmtKind.Break || stmt.kind == StmtKind.Continue) {
            // 简化处理：break/continue 在 while 中处理
        }
    }

    private void compileVarDecl(VarDecl varDecl) {
        int localIdx = this.nextLocalIndex;
        this.localIndexMap.put(varDecl.name, localIdx);
        this.currentFunc.addLocal(varDecl.name);
        this.nextLocalIndex = this.nextLocalIndex + 1;
        if (varDecl.initializer != null) {
            this.compileExpr(varDecl.initializer);
            this.currentFunc.emitWithOperand(OpCode.STORE_LOCAL, localIdx);
        }
    }

    private void compileReturn(Expr returnValue) {
        if (returnValue != null) {
            this.compileExpr(returnValue);
            this.currentFunc.emit(OpCode.RET);
        } else {
            this.currentFunc.emit(OpCode.RET_VOID);
        }
    }

    private void compileIf(Stmt stmt) {
        int elseLabel = this.freshLabel();
        int endLabel = this.freshLabel();
        this.compileExpr(stmt.condition);
        this.currentFunc.emitWithOperand(OpCode.JMP_FALSE, elseLabel);
        this.compileStmt(stmt.thenBranch);
        this.currentFunc.emitWithOperand(OpCode.JMP, endLabel);
        this.patchLabel(elseLabel);
        if (stmt.elseBranch != null) {
            this.compileStmt(stmt.elseBranch);
        }
        this.patchLabel(endLabel);
    }

    private void compileWhile(Stmt stmt) {
        int startLabel = this.freshLabel();
        int endLabel = this.freshLabel();
        this.patchLabel(startLabel);
        this.compileExpr(stmt.condition);
        this.currentFunc.emitWithOperand(OpCode.JMP_FALSE, endLabel);
        this.compileStmt(stmt.body);
        this.currentFunc.emitWithOperand(OpCode.JMP, startLabel);
        this.patchLabel(endLabel);
    }

    // ---- 表达式编译 ----

    private void compileExpr(Expr expr) {
        if (expr.kind == ExprKind.IntegerLiteral) {
            long val = expr.longValue;
            if (val >= -128 && val <= 127) {
                this.currentFunc.emitWithOperand(OpCode.PUSH_I8, (int)val);
            } else if (val >= -32768 && val <= 32767) {
                this.currentFunc.emitWithOperand(OpCode.PUSH_I16, (int)val);
            } else if (val >= -2147483648 && val <= 2147483647) {
                this.currentFunc.emitWithOperand(OpCode.PUSH_I32, (int)val);
            } else {
                this.currentFunc.emitWithLong(OpCode.PUSH_I64, val);
            }
        } else if (expr.kind == ExprKind.FloatLiteral) {
            this.currentFunc.emitWithDouble(OpCode.PUSH_F64, expr.doubleValue);
        } else if (expr.kind == ExprKind.BoolLiteral) {
            if (expr.boolValue) {
                this.currentFunc.emit(OpCode.PUSH_TRUE);
            } else {
                this.currentFunc.emit(OpCode.PUSH_FALSE);
            }
        } else if (expr.kind == ExprKind.Null) {
            this.currentFunc.emit(OpCode.PUSH_NULL);
        } else if (expr.kind == ExprKind.StringLiteral) {
            int strIdx = this.module.addString(expr.strValue);
            this.currentFunc.emitWithOperand(OpCode.PUSH_STR, strIdx);
        } else if (expr.kind == ExprKind.CharLiteral) {
            this.currentFunc.emitWithOperand(OpCode.PUSH_I8, (int)expr.charValue);
        } else if (expr.kind == ExprKind.Variable) {
            int idx = this.findLocal(expr.strValue);
            if (idx >= 0) {
                this.currentFunc.emitWithOperand(OpCode.LOAD_LOCAL, idx);
            } else if (expr.strValue.equals("self") || expr.strValue.equals("this")) {
                this.currentFunc.emit(OpCode.LOAD_THIS);
            }
        } else if (expr.kind == ExprKind.This) {
            this.currentFunc.emit(OpCode.LOAD_THIS);
        } else if (expr.kind == ExprKind.BinaryOp) {
            this.compileBinaryOp(expr);
        } else if (expr.kind == ExprKind.UnaryOp) {
            this.compileUnaryOp(expr);
        } else if (expr.kind == ExprKind.Assignment) {
            this.compileAssignment(expr);
        } else if (expr.kind == ExprKind.Call) {
            this.compileCallExpr(expr);
        } else if (expr.kind == ExprKind.MethodCall) {
            this.compileMethodCallExpr(expr);
        } else if (expr.kind == ExprKind.FieldAccess) {
            this.compileFieldAccess(expr);
        } else if (expr.kind == ExprKind.New) {
            this.compileNewExpr(expr);
        } else if (expr.kind == ExprKind.ArrayAccess) {
            this.compileExpr(expr.receiver);
            this.compileExpr(expr.index);
            this.currentFunc.emit(OpCode.ARR_GET);
        } else if (expr.kind == ExprKind.Cast) {
            this.compileExpr(expr.operand);
            // 类型转换指令
        } else if (expr.kind == ExprKind.Ternary) {
            this.compileTernary(expr);
        }
    }

    private void compileBinaryOp(Expr expr) {
        // 短路逻辑运算
        if (expr.opValue == BinaryOp.And) {
            int falseLabel = this.freshLabel();
            int endLabel = this.freshLabel();
            this.compileExpr(expr.left);
            this.currentFunc.emitWithOperand(OpCode.JMP_FALSE, falseLabel);
            this.compileExpr(expr.right);
            this.currentFunc.emitWithOperand(OpCode.JMP_FALSE, falseLabel);
            this.currentFunc.emit(OpCode.PUSH_TRUE);
            this.currentFunc.emitWithOperand(OpCode.JMP, endLabel);
            this.patchLabel(falseLabel);
            this.currentFunc.emit(OpCode.PUSH_FALSE);
            this.patchLabel(endLabel);
            return;
        }
        if (expr.opValue == BinaryOp.Or) {
            int trueLabel = this.freshLabel();
            int endLabel = this.freshLabel();
            this.compileExpr(expr.left);
            this.currentFunc.emitWithOperand(OpCode.JMP_TRUE, trueLabel);
            this.compileExpr(expr.right);
            this.currentFunc.emitWithOperand(OpCode.JMP_TRUE, trueLabel);
            this.currentFunc.emit(OpCode.PUSH_FALSE);
            this.currentFunc.emitWithOperand(OpCode.JMP, endLabel);
            this.patchLabel(trueLabel);
            this.currentFunc.emit(OpCode.PUSH_TRUE);
            this.patchLabel(endLabel);
            return;
        }

        this.compileExpr(expr.left);
        this.compileExpr(expr.right);

        int op = expr.opValue;
        if (op == BinaryOp.Add) this.currentFunc.emit(OpCode.IADD);
        else if (op == BinaryOp.Sub) this.currentFunc.emit(OpCode.ISUB);
        else if (op == BinaryOp.Mul) this.currentFunc.emit(OpCode.IMUL);
        else if (op == BinaryOp.Div) this.currentFunc.emit(OpCode.IDIV);
        else if (op == BinaryOp.Mod) this.currentFunc.emit(OpCode.IMOD);
        else if (op == BinaryOp.Eq) this.currentFunc.emit(OpCode.ICMP_EQ);
        else if (op == BinaryOp.Ne) this.currentFunc.emit(OpCode.ICMP_NE);
        else if (op == BinaryOp.Lt) this.currentFunc.emit(OpCode.ICMP_LT);
        else if (op == BinaryOp.Gt) this.currentFunc.emit(OpCode.ICMP_GT);
        else if (op == BinaryOp.Le) this.currentFunc.emit(OpCode.ICMP_LE);
        else if (op == BinaryOp.Ge) this.currentFunc.emit(OpCode.ICMP_GE);
        else if (op == BinaryOp.BitAnd) this.currentFunc.emit(OpCode.IAND);
        else if (op == BinaryOp.BitOr) this.currentFunc.emit(OpCode.IOR);
        else if (op == BinaryOp.BitXor) this.currentFunc.emit(OpCode.IXOR);
        else if (op == BinaryOp.Shl) this.currentFunc.emit(OpCode.ISHL);
        else if (op == BinaryOp.Shr) this.currentFunc.emit(OpCode.ISHR);
    }

    private void compileUnaryOp(Expr expr) {
        this.compileExpr(expr.operand);
        int op = expr.opValue;
        if (op == UnaryOp.Minus) this.currentFunc.emit(OpCode.INEG);
        else if (op == UnaryOp.Not) this.currentFunc.emit(OpCode.INOT);
        else if (op == UnaryOp.BitNot) this.currentFunc.emit(OpCode.INOT);
    }

    private void compileAssignment(Expr expr) {
        this.compileExpr(expr.value);
        if (expr.target.kind == ExprKind.Variable) {
            int idx = this.findLocal(expr.target.strValue);
            if (idx >= 0) {
                this.currentFunc.emitWithOperand(OpCode.STORE_LOCAL, idx);
                this.currentFunc.emitWithOperand(OpCode.LOAD_LOCAL, idx);
            }
        } else if (expr.target.kind == ExprKind.FieldAccess) {
            this.compileExpr(expr.target.receiver);
            int fieldIdx = this.findFieldIndex(expr.target.strValue);
            this.currentFunc.emitWithOperand(OpCode.STORE_FIELD, fieldIdx);
        }
    }

    private void compileCallExpr(Expr expr) {
        if (expr.callee.kind == ExprKind.Variable) {
            String funcName = expr.callee.strValue;
            // 编译参数
            for (int i = 0; i < expr.args.size(); i++) {
                this.compileExpr(expr.args.get(i));
            }
            int funcIdx = this.findFunctionIndex(funcName);
            this.currentFunc.emitWithOperand(OpCode.CALL, funcIdx);
        } else if (expr.callee.kind == ExprKind.FieldAccess) {
            // obj.method(args)
            this.compileExpr(expr.callee.receiver);
            for (int i = 0; i < expr.args.size(); i++) {
                this.compileExpr(expr.args.get(i));
            }
            int methodIdx = this.findMethodIndex(expr.callee.strValue);
            this.currentFunc.emitWithOperand(OpCode.CALL_VIRT, methodIdx);
        }
    }

    private void compileMethodCallExpr(Expr expr) {
        this.compileExpr(expr.receiver);
        for (int i = 0; i < expr.args.size(); i++) {
            this.compileExpr(expr.args.get(i));
        }
        int methodIdx = this.findMethodIndex(expr.strValue);
        this.currentFunc.emitWithOperand(OpCode.CALL_VIRT, methodIdx);
    }

    private void compileFieldAccess(Expr expr) {
        this.compileExpr(expr.receiver);
        int fieldIdx = this.findFieldIndex(expr.strValue);
        this.currentFunc.emitWithOperand(OpCode.LOAD_FIELD, fieldIdx);
    }

    private void compileNewExpr(Expr expr) {
        for (int i = 0; i < expr.args.size(); i++) {
            this.compileExpr(expr.args.get(i));
        }
        int classIdx = this.findClassIndex(expr.strValue);
        this.currentFunc.emitWithOperand(OpCode.NEW_OBJ, classIdx);
    }

    private void compileTernary(Expr expr) {
        int elseLabel = this.freshLabel();
        int endLabel = this.freshLabel();
        this.compileExpr(expr.condition);
        this.currentFunc.emitWithOperand(OpCode.JMP_FALSE, elseLabel);
        this.compileExpr(expr.thenExpr);
        this.currentFunc.emitWithOperand(OpCode.JMP, endLabel);
        this.patchLabel(elseLabel);
        this.compileExpr(expr.elseExpr);
        this.patchLabel(endLabel);
    }

    // ---- 辅助方法 ----

    private int findLocal(String name) {
        if (this.localIndexMap.containsKey(name)) {
            return this.localIndexMap.get(name);
        }
        return -1;
    }

    private int findFieldIndex(String fieldName) {
        if (this.currentClass != null) {
            BytecodeClass cls = this.module.findClass(this.currentClass);
            if (cls != null) {
                return cls.findField(fieldName);
            }
        }
        return 0;
    }

    private int findFunctionIndex(String funcName) {
        for (int i = 0; i < this.module.functions.size(); i++) {
            BytecodeFunction func = this.module.functions.get(i);
            String fName = func.name;
            if (fName.equals(funcName)) {
                return i;
            }
        }
        return 0;
    }

    private int findMethodIndex(String methodName) {
        // 在所有类中查找方法
        int idx = 0;
        for (int ci = 0; ci < this.module.classes.size(); ci++) {
            BytecodeClass cls = this.module.classes.get(ci);
            for (int mi = 0; mi < cls.methods.size(); mi++) {
                BytecodeFunction func = cls.methods.get(mi);
                String fName = func.name;
                if (fName.endsWith("_" + methodName)) {
                    return idx;
                }
                idx = idx + 1;
            }
        }
        return 0;
    }

    private int findClassIndex(String className) {
        for (int i = 0; i < this.module.classes.size(); i++) {
            BytecodeClass cls = this.module.classes.get(i);
            String clsName = cls.name;
            if (clsName.equals(className)) {
                return i;
            }
        }
        return 0;
    }

    private BytecodeFunction findMethod(String methodName) {
        for (int ci = 0; ci < this.module.classes.size(); ci++) {
            BytecodeClass cls = this.module.classes.get(ci);
            for (int mi = 0; mi < cls.methods.size(); mi++) {
                BytecodeFunction func = cls.methods.get(mi);
                String fName = func.name;
                if (fName.equals(methodName)) {
                    return func;
                }
            }
        }
        return null;
    }

    private BytecodeFunction findFunction(String funcName) {
        return this.module.findFunction(funcName);
    }

    private int freshLabel() {
        this.labelCounter = this.labelCounter + 1;
        return this.labelCounter;
    }

    private void patchLabel(int label) {
        // 记录标签对应的指令索引
        String key = String.intToString(label);
        this.labelPositions.put(key, this.currentFunc.instructions.size());
    }

    private void resolveLabels() {
        // 将所有 JMP/JMP_TRUE/JMP_FALSE 中的 label ID 解析为实际指令索引
        for (int i = 0; i < this.currentFunc.instructions.size(); i++) {
            BytecodeInstruction inst = this.currentFunc.instructions.get(i);
            int op = inst.opcode;
            if (op == OpCode.JMP || op == OpCode.JMP_TRUE || op == OpCode.JMP_FALSE) {
                String key = String.intToString(inst.operand);
                if (this.labelPositions.containsKey(key)) {
                    int targetIdx = this.labelPositions.get(key);
                    inst.operand = targetIdx;
                }
            }
        }
        // 清除标签记录，准备下一次函数编译
        this.labelPositions = new Map<String, int>();
        this.labelCounter = 0;
    }

    private int typeSize(TypeRef typeRef) {
        if (typeRef == null) return 8;
        if (typeRef.kind == TypeRefKind.Primitive) {
            if (typeRef.primitiveKind == PrimitiveType.Int) return 4;
            if (typeRef.primitiveKind == PrimitiveType.Long) return 8;
            if (typeRef.primitiveKind == PrimitiveType.Float) return 4;
            if (typeRef.primitiveKind == PrimitiveType.Double) return 8;
            if (typeRef.primitiveKind == PrimitiveType.Bool) return 4;
            if (typeRef.primitiveKind == PrimitiveType.Char) return 1;
            return 4;
        }
        return 8;
    }

    private String typeName(TypeRef typeRef) {
        if (typeRef == null) return "void*";
        if (typeRef.kind == TypeRefKind.Primitive) {
            if (typeRef.primitiveKind == PrimitiveType.Int) return "int";
            if (typeRef.primitiveKind == PrimitiveType.Long) return "long";
            if (typeRef.primitiveKind == PrimitiveType.Float) return "float";
            if (typeRef.primitiveKind == PrimitiveType.Double) return "double";
            if (typeRef.primitiveKind == PrimitiveType.Bool) return "bool";
            if (typeRef.primitiveKind == PrimitiveType.Char) return "char";
            return "int";
        }
        if (typeRef.kind == TypeRefKind.Named) return typeRef.name;
        if (typeRef.kind == TypeRefKind.Array) return "Array";
        return "void*";
    }
}
